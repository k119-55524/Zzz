{
    "version": 3,

    "configurePresets":
    [
        {
            "name": "release-no-logger",
            "displayName": "Release no Logger",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release-no-logger",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },

            "cacheVariables":
            {
                "CMAKE_BUILD_TYPE": "Release",
                "ZZZ_ENABLE_LOGGER": "OFF"
            }
        },

        {
            "name": "release-and-logger",
            "displayName": "Release and Logger",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release-and-logger",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },

            "cacheVariables":
            {
                "CMAKE_BUILD_TYPE": "Release",
                "ZZZ_ENABLE_LOGGER": "ON"
            }
        },

        {
            "name": "debug",
            "displayName": "Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },

            "cacheVariables":
            {
                "CMAKE_BUILD_TYPE": "Debug",
                "ZZZ_ENABLE_LOGGER": "ON"
            }
        }
    ]
}
