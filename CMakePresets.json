{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Z_BUILD_TESTS": "ON",
        "Z_BUILD_BENCHMARKS": "ON",
        "Z_USE_ASAN": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Z_BUILD_TESTS": "ON",
        "Z_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "development",
      "displayName": "Development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Development",
        "Z_BUILD_TESTS": "ON",
        "Z_BUILD_BENCHMARKS": "ON"
      }
    }
  ]
}