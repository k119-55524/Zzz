# Doxygen configuration template for Zzz Engine
# DO NOT EDIT DIRECTLY - Generated by CMake from automation/doxygen/Doxyfile.in

PROJECT_NAME           = "Zzz Engine"
PROJECT_BRIEF          = "Modern C++23 Engine & Framework"
PROJECT_NUMBER         = ""
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
DOXYFILE_ENCODING      = UTF-8

# Input configuration
INPUT                  = @DOXYGEN_INPUT_DIR@
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.cache/* \
                         *\\.cache\\* \
                         */.build/* \
                         *\\.build\\* \
                         */build/* \
                         *\\build\\* \
                         */dist/* \
                         *\\dist\\* \
                         */.git/* \
                         *\\.git\\* \
                         */.docs/* \
                         *\\.docs\\* \
                         */bin/* \
                         *\\bin\\* \
                         */obj/* \
                         *\\obj\\* \
                         */CMakeFiles/* \
                         *\\CMakeFiles\\* \
                         */_deps/* \
                         *\\_deps\\* \
                         *nlohmann* \
                         *json.hpp* \
                         *adl_serializer*

EXCLUDE_SYMBOLS        = nlohmann \
                         nlohmann::* \
                         adl_serializer

USE_MDFILE_AS_MAINPAGE = "@CMAKE_SOURCE_DIR@/README.md"
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = NO
HIDE_SCOPE_NAMES       = NO
HIDE_COMPOUND_REFERENCE= NO
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMB_INC  = YES
FORCE_LOCAL_INCLUDES   = NO
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = NO
SORT_BY_SCOPE_NAME     = NO
STRICT_PROTO_MATCHING  = NO

# Code & source navigation
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            = "@CMAKE_SOURCE_DIR@/automation/doxygen/header.html"
HTML_EXTRA_STYLESHEET  = "@DOXYGEN_AWESOME_CSS_DIR@/doxygen-awesome.css" \
                         "@DOXYGEN_AWESOME_CSS_DIR@/doxygen-awesome-sidebar-only.css" \
                         "@DOXYGEN_AWESOME_CSS_DIR@/doxygen-awesome-sidebar-only-darkmode-toggle.css"
HTML_EXTRA_FILES       = "@DOXYGEN_AWESOME_CSS_DIR@/doxygen-awesome-darkmode-toggle.js" \
                         "@DOXYGEN_AWESOME_CSS_DIR@/doxygen-awesome-interactive-toc.js"

HTML_COLORSTYLE_HUE    = 209
HTML_COLORSTYLE_SAT    = 255
HTML_COLORSTYLE_GAMMA  = 113
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100
GENERATE_DOCSET        = NO
GENERATE_HTMLHELP      = NO
GENERATE_CHI           = NO
GENERATE_QHP           = NO
GENERATE_ECLIPSEHELP   = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
EXT_LINKS_IN_WINDOW    = NO
HTML_FORMULA_FORMAT    = png
FORMULA_FONTSIZE       = 10
FORMULA_MACROFILE      = 
USE_MATHJAX            = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

# Preprocessor settings (C++23 & Project defines)
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = "@CMAKE_SOURCE_DIR@/src"
PREDEFINED             = Z_DEVELOPMENT_BUILD=1 \
                         Z_FORCE_VULKAN=1 \
                         NOMINMAX \
                         WIN32_LEAN_AND_MEAN \
                         "DOXYGEN_GENERATING_OUTPUT=1"

# Formatting / Warnings
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@CMAKE_SOURCE_DIR@/src"
SHORT_NAMES            = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
TAB_SIZE               = 4
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# Graphviz / Dot Diagrams
HAVE_DOT               = @DOXYGEN_HAVE_DOT@
DOT_PATH               = "@DOXYGEN_DOT_PATH@"
DOT_NUM_THREADS        = 0
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
DOT_TRANSPARENT        = YES
DOT_MULTI_TARGETS      = YES
GENERATE_LEGEND        = YES
DOT_CLEANUP            = YES

CLASS_DIAGRAMS         = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 20
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DIR_GRAPH_MAX_DEPTH    = 2
