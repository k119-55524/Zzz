<Window x:Class="editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:editor"
        mc:Ignorable="d"
        Title="Zzz Engine Editor" Height="720" Width="1280">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2E2E2E">
            <TextBlock Foreground="White" Margin="10" FontSize="16" FontWeight="Bold">Toolbar / Outliner</TextBlock>
        </Border>

        <!-- Наш кастомный компонент для хостинга DirectX/Vulkan -->
        <local:EngineViewHost x:Name="ViewHost" Grid.Column="1" />
    </Grid>
</Window>
