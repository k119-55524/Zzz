<Window x:Class="BuildConfigurator.Views.Dialogs.EditConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать конфигурацию"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushSurface}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Имя конфигурации" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
        <Grid>
            <TextBox x:Name="NameBox" MaxLength="25"
                     Style="{StaticResource DarkTextBoxStyle}"
                     TextChanged="NameBox_TextChanged"/>
            <TextBlock x:Name="NameCounter" Text="0 / 25"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                       IsHitTestVisible="False"/>
        </Grid>
        <TextBlock x:Name="NameError" Foreground="{StaticResource BrushDanger}"
                   FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>

        <TextBlock Text="Описание" Style="{StaticResource LabelStyle}" Margin="0,16,0,4"/>
        <Grid>
            <TextBox x:Name="DescBox" MaxLength="100"
                     Style="{StaticResource DarkTextBoxStyle}"
                     TextChanged="DescBox_TextChanged"/>
            <TextBlock x:Name="DescCounter" Text="0 / 100"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                       IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}"
                    Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}"
                    Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
