<Window x:Class="AdminPanelWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zzz Admin Panel Win" Height="450" Width="700"
        Icon="pack://application:,,,/Properties/AppIcon.ico">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Name="BtnStart" Content="Connect" Width="100" Height="30" Margin="0,0,10,0" Click="BtnStart_Click"/>
            <Button Name="BtnStop" Content="Disconnect" Width="100" Height="30" Click="BtnStop_Click" IsEnabled="False"/>
        </StackPanel>

        <TextBox Name="TxtLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Zzz Admin Panel Win Initialized...&#x0a;"/>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="TxtStatus" Text="Status: Disconnected"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
