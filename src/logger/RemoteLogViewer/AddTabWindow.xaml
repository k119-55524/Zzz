<Window x:Class="RemoteLogViewer.AddTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая вкладка" Height="150" Width="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выберите адрес для прослушивания:" Grid.Row="0" Margin="0,0,0,5"/>
        
        <ComboBox x:Name="CmbAddresses" Grid.Row="1" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Создать" Width="70" Click="BtnCreate_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="70" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
