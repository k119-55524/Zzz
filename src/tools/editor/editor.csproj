<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8600;CS8603;CS8604;CS8625;CS0168</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableUnmanagedDebugging>true</EnableUnmanagedDebugging>
    <ApplicationIcon>Properties\AppIcon.ico</ApplicationIcon>

    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU;x64</Platforms>

    <OutputPath>..\..\..\dist\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Конфигурация с отладкой -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Конфигурация без отладки -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- editor_dll собирается через C++ проект (editor_dll.vcxproj) в решении Tools.sln.
       Запуск cmake build отключается при сборке решения в VS/MSBuild, чтобы избежать ошибок с путями SDK. -->
  <Target Name="BuildEditorDLL" BeforeTargets="Build" Condition="'$(BuildingSolutionFile)' != 'true' And '$(BuildingInsideVisualStudio)' != 'true'">
    <PropertyGroup>
      <Z_TargetDir Condition="'$(Configuration)' == 'Debug'">$(MSBuildThisFileDirectory)..\..\..\dist\Debug</Z_TargetDir>
      <Z_TargetDir Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)..\..\..\dist\Release</Z_TargetDir>
      <Z_CMakeBuildDir Condition="'$(Configuration)' == 'Debug'">$(MSBuildThisFileDirectory)..\..\..\build\Windows\debug</Z_CMakeBuildDir>
      <Z_CMakeBuildDir Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)..\..\..\build\Windows\release</Z_CMakeBuildDir>
    </PropertyGroup>
    <!-- Вызываем cmake build только если бинарник отсутствует и мы собираем проект отдельно -->
    <PropertyGroup>
      <Z_CMakeStandaloneOutDir>$(Z_CMakeBuildDir)\bin_standalone</Z_CMakeStandaloneOutDir>
    </PropertyGroup>
    <Exec Command="cmake --build &quot;$(Z_CMakeBuildDir)&quot; --target editor_dll" Condition="'$(Z_CMakeBuildDir)' != '' And Exists('$(Z_CMakeBuildDir)') And !Exists('$(Z_TargetDir)\editor_dll.dll')" />
    <!-- editor_dll CMake-сборка пишет в свою изолированную папку (см. src/editor_dll/CMakeLists.txt),
         чтобы не конфликтовать с editor_dll.vcxproj. Переносим результат в bin/$(Configuration) сами. -->
    <ItemGroup>
      <Z_EditorDllStandaloneFiles Include="$(Z_CMakeStandaloneOutDir)\editor_dll.dll;$(Z_CMakeStandaloneOutDir)\editor_dll.pdb" />
      <Z_EditorDllStandaloneExistingFiles Include="@(Z_EditorDllStandaloneFiles)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
    <Copy SourceFiles="@(Z_EditorDllStandaloneExistingFiles)" DestinationFolder="$(Z_TargetDir)" Condition="'@(Z_EditorDllStandaloneExistingFiles)' != ''" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Properties\AppIcon.ico" />
  </ItemGroup>

  <!-- Шаблоны скриптов (см. AssetsWidget.GetTemplatesDirectory) хранятся в src/editor_dll/templates/scripts -
       копируем их в выходную папку рядом с editor.exe, чтобы создание скриптов работало и в развёрнутом
       (не из репозитория разработчика) билде, а не только благодаря fallback-пути внутрь репозитория. -->
  <ItemGroup>
    <None Include="..\..\editor_dll\templates\scripts\**\*.template">
      <Link>templates\scripts\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Автогенерация версии сборки на основе даты/времени перед компиляцией -->
  <Target Name="GenerateVersionFile" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <Z_EpochTicks>639017376000000000</Z_EpochTicks> <!-- Ticks for 2026-01-01 00:00:00 UTC -->
      <Z_NowTicks>$([System.DateTime]::UtcNow.Ticks)</Z_NowTicks>
      <Z_DiffTicks>$([MSBuild]::Subtract($(Z_NowTicks), $(Z_EpochTicks)))</Z_DiffTicks>
      <!-- Делим на 600,000,000 (количество Ticks в минуте), затем на 10 для 10-минутного интервала -->
      <Z_BuildVersion>$([MSBuild]::Divide($(Z_DiffTicks), 6000000000))</Z_BuildVersion>
      <Z_BuildVersion>$([System.Math]::Floor($(Z_BuildVersion)))</Z_BuildVersion>
      <Z_VersionCode>1</Z_VersionCode>
      <Z_BuildDate>$([System.DateTime]::Now.ToString("dd.MM.yyyy HH:mm:ss"))</Z_BuildDate>
    </PropertyGroup>

    <ItemGroup>
      <Z_Lines Include="namespace editor%3B" />
      <Z_Lines Include="public static class EditorConstants" />
      <Z_Lines Include="{" />
      <Z_Lines Include="    public const string ApplicationName = &quot;ZzzEditor&quot;%3B" />
      <Z_Lines Include="    public const string Version = &quot;1.0.0:$(Z_BuildVersion)&quot;%3B" />
      <Z_Lines Include="    public const int VersionCode = $(Z_VersionCode)%3B" />
      <Z_Lines Include="    public const string BuildDate = &quot;$(Z_BuildDate)&quot;%3B" />
      <Z_Lines Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(MSBuildProjectDirectory)\Models\EditorVersion.cs" Lines="@(Z_Lines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>

