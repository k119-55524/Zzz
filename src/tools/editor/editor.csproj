<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableUnmanagedDebugging>true</EnableUnmanagedDebugging>

    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU;x64</Platforms>

    <OutputPath>..\..\..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Конфигурация с отладкой -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Конфигурация без отладки -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- editorDLL собирается через CMake/Ninja отдельно от этого проекта (include_external_msproject
       не работает с генератором Ninja), поэтому пересборка native-зависимости вызывается явно. -->
  <Target Name="BuildEditorDLL" BeforeTargets="Build">
    <PropertyGroup>
      <Z_CMakeBuildDir Condition="'$(Configuration)' == 'Debug'">$(MSBuildThisFileDirectory)..\..\..\build\Windows\debug</Z_CMakeBuildDir>
      <Z_CMakeBuildDir Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)..\..\..\build\Windows\release</Z_CMakeBuildDir>
    </PropertyGroup>
    <Exec Command="cmake --build &quot;$(Z_CMakeBuildDir)&quot; --target editorDLL" Condition="'$(Z_CMakeBuildDir)' != '' And Exists('$(Z_CMakeBuildDir)')" />
  </Target>

</Project>
