<Window x:Class="editor.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:dockLayout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:dockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:vsTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
        xmlns:svc="clr-namespace:editor.Services"
        xmlns:conv="clr-namespace:editor.Views.Converters"
        xmlns:vm="clr-namespace:editor.ViewModels"
        xmlns:widgets="clr-namespace:editor.Views.Widgets"
        mc:Ignorable="d"
        Background="{DynamicResource Brush_Window_Background}"
        Title="{Binding WindowTitle}" Height="720" Width="1280" Icon="pack://application:,,,/Properties/AppIcon.ico"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Шаблон для отображения элементов языков в выпадающем меню -->
        <DataTemplate x:Key="LanguageTemplate" DataType="{x:Type vm:MainWindowViewModel+LanguageItem}">
            <Grid Height="15" Margin="4,2,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <ContentControl Content="{Binding Code}" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Code}" Value="ru-RU">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Grid Width="16" Height="11">
                                                    <Border ClipToBounds="True" BorderBrush="#88FFFFFF" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <Rectangle Grid.Row="0" Fill="#FFFFFF" />
                                                            <Rectangle Grid.Row="1" Fill="#0039A6" />
                                                            <Rectangle Grid.Row="2" Fill="#D52B1E" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Code}" Value="en-US">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <Grid Width="16" Height="11">
                                                    <Border ClipToBounds="True" BorderBrush="#88FFFFFF" BorderThickness="1">
                                                        <Grid>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <Rectangle Grid.Row="0" Fill="#B22234" />
                                                                <Rectangle Grid.Row="1" Fill="#FFFFFF" />
                                                                <Rectangle Grid.Row="2" Fill="#B22234" />
                                                                <Rectangle Grid.Row="3" Fill="#FFFFFF" />
                                                                <Rectangle Grid.Row="4" Fill="#B22234" />
                                                                <Rectangle Grid.Row="5" Fill="#FFFFFF" />
                                                                <Rectangle Grid.Row="6" Fill="#B22234" />
                                                            </Grid>
                                                            <Rectangle Width="8" Height="6" Fill="#3C3B6E" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource Brush_Text_Primary}" Margin="0,0,4,0" />
            </Grid>
        </DataTemplate>

        <Style x:Key="LanguageMenuHeaderStyle" TargetType="MenuItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid x:Name="Grid" Background="Transparent">
                            <ContentPresenter ContentSource="Header" Margin="4,2,4,2" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                                <Border Background="{DynamicResource Brush_Panel_Header}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,4,0,0">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grid" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <CollectionViewSource x:Key="PanesCollection" Source="{Binding Panes}" />
        <!-- Стилизация кнопок тулбара -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Secondary}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки управления окном (свернуть/закрыть) -->
        <Style x:Key="ChromeWindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}" />
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F41" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeWindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeWindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Хоткеи Undo / Redo -->
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <!-- SystemCommands сами по себе ничего не делают — нужно явно привязать их к SystemCommands.XxxWindow(this) -->
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="MaximizeWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="RestoreWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="CloseWindow_Executed" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Заголовок и Меню -->
            <RowDefinition Height="Auto" /> <!-- Панель инструментов (Toolbar) -->
            <RowDefinition Height="*" />    <!-- Стыкуемые панели -->
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush_Window_Background}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,0,0,1" Height="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- 0. Иконка, Имя и Звездочка -->
                    <ColumnDefinition Width="Auto" /> <!-- 1. Меню (только под размер пунктов) -->
                    <ColumnDefinition Width="*" />    <!-- 2. Свободная область для перетаскивания -->
                    <ColumnDefinition Width="Auto" /> <!-- 3. Кнопки закрыть/свернуть -->
                </Grid.ColumnDefinitions>

                <!-- 1. Иконка приложения и Имя проекта + фиксированный зазор под звездочку -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="pack://application:,,,/Properties/AppIcon.ico" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppName}" Foreground="{DynamicResource Brush_Text_Primary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text=" - [" Foreground="{DynamicResource Brush_Text_Primary}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProjectDisplayName}" Foreground="{DynamicResource Brush_Text_Primary}" VerticalAlignment="Center" />
                    <TextBlock Text="]" Foreground="{DynamicResource Brush_Text_Primary}" VerticalAlignment="Center" />
                    <!-- Фиксированное текстовое поле для звездочки. Видимость/текст меняются, но ширина закреплена, чтобы меню не прыгало -->
                    <Grid Width="10" Margin="1,0,10,0">
                        <TextBlock Text="*" Foreground="#E81123" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"
                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>

                <!-- 2. Главное меню редактора (активно в Chrome) -->
                <Menu Grid.Column="1" Background="Transparent" Foreground="{DynamicResource Brush_Text_Primary}" VerticalAlignment="Center" Margin="5,0,10,0"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="{DynamicResource Menu_File}" Foreground="{DynamicResource Brush_Text_Primary}">
                        <MenuItem Header="{DynamicResource Menu_File_Create}" Command="{Binding NewProjectCommand}" />
                        <MenuItem Header="{DynamicResource Menu_File_Open}" Command="{Binding OpenProjectCommand}" />
                        <MenuItem Header="{DynamicResource Menu_File_Close}" Command="{Binding CloseProjectCommand}" />
                        <Separator Background="{DynamicResource Brush_Border}" />
                        <MenuItem x:Name="MenuRecentProjects" Header="{DynamicResource Menu_File_Recent}"
                                  ItemsSource="{Binding RecentProjects}"
                                  IsEnabled="{Binding HasRecentProjects}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding}" />
                                    <Setter Property="Command" Value="{Binding DataContext.OpenRecentProjectCommand, ElementName=RootWindow}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator Background="{DynamicResource Brush_Border}" />
                        <MenuItem Header="{DynamicResource Menu_File_Exit}" Command="{Binding ExitCommand}" />
                    </MenuItem>
                    <MenuItem x:Name="MenuWindow" Header="{DynamicResource Menu_Window}" Foreground="{DynamicResource Brush_Text_Primary}">
                        <MenuItem.ItemsSource>
                            <CompositeCollection>
                                <MenuItem Header="{DynamicResource Menu_Window_Reset}" 
                                          Command="{Binding ResetLayoutCommand}" 
                                          Style="{x:Null}" />
                                <Separator Background="{DynamicResource Brush_Border}" Style="{x:Null}" />
                                <CollectionContainer Collection="{Binding Source={StaticResource PanesCollection}}" />
                            </CompositeCollection>
                        </MenuItem.ItemsSource>
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Title}" />
                                <Setter Property="Command" Value="{Binding DataContext.ShowWidgetCommand, ElementName=RootWindow}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Menu_Help}" Foreground="{DynamicResource Brush_Text_Primary}">
                        <MenuItem Header="{DynamicResource Menu_Help_About}" Command="{Binding AboutCommand}" />
                    </MenuItem>
                </Menu>

                <!-- Свободная область для перетаскивания (просто пустой Border, невидимый для хит-тестов XAML, чтобы клик шел в Chrome) -->
                <Border Grid.Column="2" Background="Transparent" />

                <!-- 3. Системные кнопки окна Windows -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Выпадающий список выбора языка -->
                    <Menu Background="Transparent" Margin="0,0,12,0" VerticalAlignment="Center">
                        <MenuItem ItemsSource="{Binding AvailableLanguages}" 
                                  Style="{StaticResource LanguageMenuHeaderStyle}">
                            <MenuItem.Header>
                                <ContentControl Content="{Binding SelectedLanguage.Code}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedLanguage.Code}" Value="ru-RU">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Grid Width="16" Height="11">
                                                                    <Border ClipToBounds="True" BorderBrush="#88FFFFFF" BorderThickness="1" Cursor="Hand">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="*" />
                                                                                <RowDefinition Height="*" />
                                                                                <RowDefinition Height="*" />
                                                                            </Grid.RowDefinitions>
                                                                            <Rectangle Grid.Row="0" Fill="#FFFFFF" />
                                                                            <Rectangle Grid.Row="1" Fill="#0039A6" />
                                                                            <Rectangle Grid.Row="2" Fill="#D52B1E" />
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedLanguage.Code}" Value="en-US">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Grid Width="16" Height="11">
                                                                    <Border ClipToBounds="True" BorderBrush="#88FFFFFF" BorderThickness="1" Cursor="Hand">
                                                                        <Grid>
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="*" />
                                                                                    <RowDefinition Height="*" />
                                                                                    <RowDefinition Height="*" />
                                                                                    <RowDefinition Height="*" />
                                                                                    <RowDefinition Height="*" />
                                                                                    <RowDefinition Height="*" />
                                                                                    <RowDefinition Height="*" />
                                                                                </Grid.RowDefinitions>
                                                                                <Rectangle Grid.Row="0" Fill="#B22234" />
                                                                                <Rectangle Grid.Row="1" Fill="#FFFFFF" />
                                                                                <Rectangle Grid.Row="2" Fill="#B22234" />
                                                                                <Rectangle Grid.Row="3" Fill="#FFFFFF" />
                                                                                <Rectangle Grid.Row="4" Fill="#B22234" />
                                                                                <Rectangle Grid.Row="5" Fill="#FFFFFF" />
                                                                                <Rectangle Grid.Row="6" Fill="#B22234" />
                                                                            </Grid>
                                                                            <Rectangle Width="8" Height="6" Fill="#3C3B6E" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </MenuItem.Header>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding}" />
                                    <Setter Property="Command" Value="{Binding DataContext.SwitchLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Border x:Name="BgBorder" Background="Transparent" SnapsToDevicePixels="True" CornerRadius="3" Padding="6,4">
                                                    <ContentPresenter ContentSource="Header" ContentTemplate="{StaticResource LanguageTemplate}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BgBorder" Property="Background" Value="#3E3E42" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </Menu>

                    <Button Content="—" Style="{StaticResource ChromeWindowButtonStyle}" Focusable="False"
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Focusable="False" CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChromeWindowButtonStyle}">
                                <Setter Property="Content" Value="🗖" />
                                <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="🗗" />
                                        <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Style="{StaticResource ChromeWindowCloseButtonStyle}" Focusable="False"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Строка 1: Панель управления -->
        <Border Grid.Row="1" Background="{DynamicResource Brush_Panel_Header}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,0,0,1" Padding="5">
            <Grid>
                <!-- Левая часть: Undo, Redo и Трансформации -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Кнопка сохранения (Сохранить) в стиле VS -->
                    <Button Command="{Binding SaveCommand}" ToolTip="Сохранить (Ctrl+S)" Style="{StaticResource ToolbarButtonStyle}" Width="30" Height="25">
                        <Path Data="M2,2 L10,2 L12,4 L12,12 L2,12 Z M4,2 L4,6 L8,6 L8,2 Z M5,12 L5,8 L9,8 L9,12 Z"
                              Stroke="#007ACC" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <!-- Undo / Redo кнопки -->
                    <Button Content="↩" ToolTip="Ctrl+Z" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding UndoCommand}" />
                    <Button Content="↪" ToolTip="Ctrl+Y" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RedoCommand}" />
                </StackPanel>

                <!-- Центральная часть: Управление симуляцией (Play, Pause, Stop) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Запуск (Зеленый треугольник) -->
                    <Button ToolTip="Запуск" Style="{StaticResource ToolbarButtonStyle}" Width="30" Height="25" Command="{Binding PlayCommand}">
                        <Path Data="M 0,0 L 10,6 L 0,12 Z" Fill="#5CDB7B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </Button>

                    <!-- Пауза (Две закругленные вертикальные полосы) -->
                    <Button ToolTip="Пауза" Style="{StaticResource ToolbarButtonStyle}" Width="30" Height="25" Command="{Binding PauseCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="3" Height="10" Background="#E0E0E0" CornerRadius="1" Margin="0,0,2,0" />
                            <Border Width="3" Height="10" Background="#E0E0E0" CornerRadius="1" />
                        </StackPanel>
                    </Button>

                    <!-- Стоп (Красный закругленный квадрат) -->
                    <Button ToolTip="Стоп" Style="{StaticResource ToolbarButtonStyle}" Width="30" Height="25" Command="{Binding StopCommand}">
                        <Border Width="9" Height="9" Background="#F25C5C" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Строка 2: DockingManager -->
        <dock:DockingManager x:Name="DockManager" Grid.Row="2" Background="{DynamicResource Brush_Window_Background}"
                             AnchorablesSource="{Binding Panes}"
                             AnchorableClosing="DockManager_AnchorableClosing"
                             GridSplitterWidth="3"
                             GridSplitterHeight="3">
            <dock:DockingManager.Resources>
                <ResourceDictionary>
                    <!-- Компактная версия заголовка панели AvalonDock: только кнопки (▾ список / 📌 автоскрытие / ✕ скрыть),
                         без текста заголовка — текст теперь показывают сами закладки в общей строке -->
                    <Style TargetType="{x:Type dockControls:AnchorablePaneTitle}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type dockControls:AnchorablePaneTitle}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
                                            <Button x:Name="PART_AutoHidePin"
                                                Command="{Binding Path=LayoutItem.AutoHideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                Focusable="False" Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource Brush_Text_Secondary}" Padding="3,0" Content="📌"
                                                ToolTip="Автоскрытие">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}">
                                                        <Setter Property="Visibility" Value="{Binding Path=Model.CanAutoHide, RelativeSource={RelativeSource AncestorType=dockControls:AnchorablePaneTitle}, Converter={StaticResource BoolToVis}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Path=Model.IsFloating, RelativeSource={RelativeSource AncestorType=dockControls:AnchorablePaneTitle}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="PART_HidePin"
                                                Command="{Binding Path=LayoutItem.HideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                Focusable="False" Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource Brush_Text_Secondary}" Padding="3,0" Content="✕"
                                                ToolTip="Скрыть"
                                                Visibility="{Binding Path=IsEnabled, RelativeSource={RelativeSource Self}, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Model.CanClose, RelativeSource={RelativeSource Mode=Self}}" Value="True">
                                            <Setter TargetName="PART_HidePin" Property="Command" Value="{Binding Path=LayoutItem.CloseCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Убираем собственный заголовок LayoutAnchorableControl — теперь заголовок и кнопки
                         показываются в одной строке с закладками панели (см. стиль ниже) -->
                    <Style TargetType="{x:Type dockControls:LayoutAnchorableControl}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type dockControls:LayoutAnchorableControl}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            KeyboardNavigation.TabNavigation="Cycle">
                                        <ContentPresenter
                                            Content="{Binding LayoutItem.View, RelativeSource={RelativeSource TemplatedParent}}"
                                            ContentTemplate="{Binding LayoutItem.View.ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                            ContentTemplateSelector="{Binding LayoutItem.View.ContentTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                            FlowDirection="{TemplateBinding FlowDirection}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- LayoutAnchorablePaneControl каким-то образом не подхватывает обычный implicit-lookup
                         (ни по своему типу, ни по типу TabControl, от которого наследует DefaultStyleKey) —
                         стиль назначается явно через код в MainWindow.xaml.cs (см. ApplyCompactPaneStyle).
                         Закладки + заголовок объединены в одну верхнюю строку (вместо закладок снизу и
                         отдельного заголовка сверху) — экономит вертикальное место -->
                    <Style x:Key="CompactAnchorablePaneStyle" TargetType="{x:Type TabControl}">
                        <Setter Property="Foreground" Value="{Binding Model.Root.Manager.Foreground, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="Background" Value="{Binding Model.Root.Manager.Background, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabControl}">
                                    <!-- Контур в форме "флажка" (закладка + поле контента как одна непрерывная
                                         фигура) пересчитывается динамически в MainWindow.xaml.cs
                                         (см. UpdateTabSelectionOutline) — статичный Border тут не подходит,
                                         т.к. форма зависит от того, какая закладка активна и какой она ширины -->
                                    <Grid x:Name="RootGrid" KeyboardNavigation.TabNavigation="Local">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="{StaticResource Brush_Panel_Header}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <dockControls:AnchorablePaneTabPanel x:Name="HeaderPanel"
                                                    Grid.Column="0"
                                                    Panel.ZIndex="1"
                                                    IsItemsHost="True"
                                                    KeyboardNavigation.TabIndex="1" />

                                                <dockControls:AnchorablePaneTitle Grid.Column="1"
                                                    Model="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}" />
                                            </Grid>
                                        </Border>

                                        <Border x:Name="ContentPanel" Grid.Row="1"
                                                Background="{StaticResource Brush_Panel_Background}"
                                                CornerRadius="0,0,5,5"
                                                KeyboardNavigation.DirectionalNavigation="Contained"
                                                KeyboardNavigation.TabIndex="2"
                                                KeyboardNavigation.TabNavigation="Cycle">
                                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                                Margin="{TemplateBinding Padding}"
                                                ContentSource="SelectedContent"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Border>

                                        <Path x:Name="SelectionOutline" Grid.RowSpan="2"
                                              Stroke="{StaticResource Brush_Accent}" StrokeThickness="1"
                                              IsHitTestVisible="False" SnapsToDevicePixels="True" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <Setter Property="ItemContainerStyle">
                            <Setter.Value>
                                <Style TargetType="{x:Type TabItem}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                     <Setter Property="Padding" Value="10,6" />
                                     <Setter Property="Foreground" Value="{StaticResource Brush_Text_Primary}" />
                                     <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type TabItem}">
                                                <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                        Background="Transparent"
                                                        CornerRadius="4,4,0,0"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter x:Name="Content"
                                                        HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        ContentSource="Header"
                                                        RecognizesAccessKey="True"
                                                        TextElement.Foreground="{TemplateBinding Foreground}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- Активная закладка окрашивается тем же цветом, что и область контента —
                                                         визуально они становятся одной непрерывной поверхностью -->
                                                    <Trigger Property="Selector.IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush_Panel_Background}" />
                                                        <Setter TargetName="Bd" Property="Margin" Value="0,0,0,-1" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush_Text_Primary}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True" />
                                                            <Condition Property="Selector.IsSelected" Value="False" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush_Border}" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush_Text_Primary}" />
                                                    </MultiTrigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush_Text_Primary}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Setter.Value>
                        </Setter>

                        <Setter Property="ItemTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <dockControls:LayoutAnchorableTabItem Model="{Binding}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>

                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <dockControls:LayoutAnchorableControl Model="{Binding}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </dock:DockingManager.Resources>
            <dock:DockingManager.Theme>
                <vsTheme:Vs2013DarkTheme />
            </dock:DockingManager.Theme>
            <dock:DockingManager.LayoutUpdateStrategy>
                <svc:PaneLayoutUpdateStrategy />
            </dock:DockingManager.LayoutUpdateStrategy>
            <dock:DockingManager.LayoutItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" />
                </DataTemplate>
            </dock:DockingManager.LayoutItemTemplate>
            <dockLayout:LayoutRoot>
                <dockLayout:LayoutPanel Orientation="Horizontal">
                    <!-- Левая панель: Иерархия (SceneTree) и Проект (Assets) по горизонтали 50/50 -->
                    <dockLayout:LayoutPanel Orientation="Vertical" DockWidth="250">
                        <dockLayout:LayoutAnchorablePane x:Name="PaneLeft" Name="PaneLeft" DockHeight="*" />
                        <dockLayout:LayoutAnchorablePane x:Name="PaneLeftBottom" Name="PaneLeftBottom" DockHeight="*" />
                    </dockLayout:LayoutPanel>

                    <!-- Центральная и нижняя панели -->
                    <dockLayout:LayoutPanel Orientation="Vertical" DockWidth="*">
                        <!-- Центр: Сцена (Render), Настройки (Settings), Сборка (Build) -->
                        <dockLayout:LayoutAnchorablePane x:Name="PaneCenterTop" Name="PaneCenterTop" />

                        <!-- Низ: Консоль (Console) -->
                        <dockLayout:LayoutAnchorablePane x:Name="PaneBottom" Name="PaneBottom" DockHeight="200" />
                    </dockLayout:LayoutPanel>

                    <!-- Правая панель: Инспектор (Inspector) -->
                    <dockLayout:LayoutAnchorablePane x:Name="PaneRight" Name="PaneRight" DockWidth="300" />
                </dockLayout:LayoutPanel>
            </dockLayout:LayoutRoot>
        </dock:DockingManager>
    </Grid>
</Window>
