<Window x:Class="editor.Views.NewScriptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="{DynamicResource Dialog_NewScript_Title}" Height="300" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{DynamicResource Brush_Window_Background}"
        BorderBrush="{DynamicResource Brush_Text_Primary}"
        BorderThickness="1"
        FontFamily="Roboto Mono">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brush_Panel_Header}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,0,0,1" Height="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Dialog_NewScript_Title}" Foreground="{DynamicResource Brush_Text_Primary}" FontWeight="SemiBold" FontSize="12" Margin="10,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="X" Style="{StaticResource EditorDialogHeaderCloseButtonStyle}" Focusable="False" Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Dialog_NewScript_Base}" Foreground="{DynamicResource Brush_Text_Primary}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" x:Name="ScriptTypeComboBox" Style="{StaticResource EditorDialogComboBoxStyle}" SelectionChanged="ValidateInput">
                    <ComboBoxItem Tag="Script" Content="{DynamicResource ScriptType_Script}" IsSelected="True" />
                    <ComboBoxItem Tag="Game" Content="{DynamicResource ScriptType_Game}" />
                    <ComboBoxItem Tag="Scene" Content="{DynamicResource ScriptType_Scene}" />
                    <ComboBoxItem Tag="View" Content="{DynamicResource ScriptType_View}" />
                </ComboBox>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Dialog_NewScript_Namespace}" Foreground="{DynamicResource Brush_Text_Primary}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          x:Name="NamespaceComboBox"
                          Style="{StaticResource EditorDialogComboBoxStyle}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          primitives:TextBoxBase.TextChanged="ValidateInput">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Content="X"
                                        Width="22"
                                        Height="18"
                                        Padding="0"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource EditorDialogButtonStyle}"
                                        CommandParameter="{Binding}"
                                        Click="DeleteNamespace_Click" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="White" />
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Dialog_NewScript_Name}" Foreground="{DynamicResource Brush_Text_Primary}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="ScriptNameTextBox" Style="{StaticResource EditorDialogTextBoxStyle}" TextChanged="ValidateInput" />
            </Grid>

            <TextBlock Grid.Row="5" x:Name="StatusTextBlock" Foreground="#F25C5C" TextWrapping="Wrap" Margin="0,10,0,0" VerticalAlignment="Top" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Brush_Panel_Header}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,1,0,0" Padding="15,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="{DynamicResource Dialog_NewScript_Add}" x:Name="AddButton" Style="{StaticResource EditorDialogAccentButtonStyle}" Click="Add_Click" Margin="0,0,8,0" IsEnabled="False" />
                <Button Content="{DynamicResource Dialog_NewScript_Cancel}" Style="{StaticResource EditorDialogButtonStyle}" Click="Cancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
