<UserControl x:Class="editor.Views.Widgets.AssetsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:infra="clr-namespace:editor.Services.Project.Infrastructure"
             xmlns:vm="clr-namespace:editor.ViewModels"
             xmlns:converters="clr-namespace:editor.Views.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Векторная иконка папки -->
        <VisualBrush x:Key="Icon_Folder" Stretch="Uniform">
            <VisualBrush.Visual>
                <Canvas Width="24" Height="24">
                    <Path Fill="#FFE0A96D" Data="M10 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2h-8l-2-2z"/>
                </Canvas>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- Векторная иконка файла -->
        <VisualBrush x:Key="Icon_File" Stretch="Uniform">
            <VisualBrush.Visual>
                <Canvas Width="24" Height="24">
                    <Path Fill="#FF90A4AE" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                </Canvas>
            </VisualBrush.Visual>
        </VisualBrush>

         <!-- Стиль для ToggleButton в стиле тулбара -->
        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Checked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для MenuItem в шапке (Кнопка-меню фильтра) -->
        <Style x:Key="FlatMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom">
                                <Border Background="{DynamicResource Brush_Panel_Background}"
                                        BorderBrush="{DynamicResource Brush_Border}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="2">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для Button в стиле тулбара -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush_Panel_Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления (Toolbar) -->
        <Border Grid.Row="0" 
                Background="{DynamicResource Brush_Panel_Header}" 
                BorderBrush="{DynamicResource Brush_Border}" 
                BorderThickness="0,0,0,1" 
                Padding="6,4">
            <StackPanel Orientation="Horizontal">
                
                <!-- Переключатель режима: Ассеты / Система (с векторными иконками) -->
                <ToggleButton IsChecked="{Binding IsSystemMode}"
                               Style="{StaticResource ToolbarToggleButtonStyle}"
                               Margin="2,0"
                               Cursor="Hand">
                    <ToggleButton.ToolTip>
                        <ToolTip Content="Switch View Mode (Assets / System)" Background="#2D2D30" Foreground="{DynamicResource Brush_Text_Primary}" BorderBrush="{DynamicResource Brush_Border}"/>
                    </ToggleButton.ToolTip>
                    <Path Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Margin="4">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M12,4 L20,8 L12,12 L4,8 Z M4,12 L12,16 L20,12 M4,16 L12,20 L20,16"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemMode}" Value="True">
                                        <Setter Property="Data" Value="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </ToggleButton>

                <!-- Фильтр обязательных папок (Плоская кнопка с иконкой воронки) -->
                <Menu Background="Transparent" Margin="2,0">
                    <MenuItem Style="{StaticResource FlatMenuItemStyle}" Cursor="Hand">
                        <MenuItem.ToolTip>
                            <ToolTip Content="Filter Resource Types" Background="#2D2D30" Foreground="{DynamicResource Brush_Text_Primary}" BorderBrush="{DynamicResource Brush_Border}"/>
                        </MenuItem.ToolTip>
                        <MenuItem.Header>
                            <Path Data="M3,5 L21,5 L14,12 L14,19 L10,19 L10,12 Z" Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="16" Height="16"/>
                        </MenuItem.Header>
                        <MenuItem.ItemsSource>
                            <Binding Path="AvailableFilters"/>
                        </MenuItem.ItemsSource>
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" 
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Foreground="{DynamicResource Brush_Text_Primary}"
                                                      Margin="4,2"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="StaysOpenOnClick" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="BgBorder" Background="Transparent" SnapsToDevicePixels="True" CornerRadius="3" Padding="2">
                                                <ContentPresenter ContentSource="Header" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource Brush_Hover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </Menu>

                <!-- Кнопка сброса фильтра для текущего дерева -->
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ResetFiltersCommand}" Margin="2,0">
                    <Button.ToolTip>
                        <ToolTip Content="Reset Current Filters" Background="#2D2D30" Foreground="{DynamicResource Brush_Text_Primary}" BorderBrush="{DynamicResource Brush_Border}"/>
                    </Button.ToolTip>
                    <Path Data="M2,4 L14,4 L9,9 L9,15 L7,15 L7,9 Z M13,10 L17,14 M17,10 L13,14" 
                          Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="16" Height="16"/>
                </Button>

            </StackPanel>
        </Border>

        <!-- Дерево виртуальной файловой системы -->
         <TreeView Grid.Row="1" 
                   ItemsSource="{Binding VirtualRootNodes}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="5"
                   SelectedItemChanged="TreeView_SelectedItemChanged"
                   ContextMenuOpening="TreeView_ContextMenuOpening">
             <TreeView.ContextMenu>
                 <ContextMenu>
                     <MenuItem Header="{DynamicResource ContextMenu_Add}">
                         <MenuItem Header="{DynamicResource ContextMenu_Folder}" Click="AddFolderToRoot_Click" />
                     </MenuItem>
                 </ContextMenu>
             </TreeView.ContextMenu>
            
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type infra:VirtualNode}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <!-- Векторная иконка -->
                        <Rectangle x:Name="NodeIcon" 
                                   Width="14" 
                                   Height="14" 
                                   Margin="0,0,6,0" 
                                   Fill="{StaticResource Icon_File}"/>
                        
                        <!-- Текст элемента -->
                        <Grid>
                            <TextBlock x:Name="NodeText" 
                                       Text="{Binding DisplayName}" 
                                       Foreground="{DynamicResource Brush_Text_Primary}" 
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBox x:Name="NodeEditTextBox"
                                     Text="{Binding DisplayName, Mode=OneWay, UpdateSourceTrigger=LostFocus}"
                                     Foreground="{DynamicResource Brush_Text_Primary}"
                                     Background="#252526"
                                     BorderBrush="#007ACC"
                                     BorderThickness="1"
                                     MinWidth="100"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Loaded="NodeEditTextBox_Loaded"
                                     LostFocus="NodeEditTextBox_LostFocus"
                                     KeyDown="NodeEditTextBox_KeyDown"/>
                        </Grid>
                    </StackPanel>
                    
                    <HierarchicalDataTemplate.Triggers>
                        <!-- Триггер для обычных папок -->
                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                            <Setter TargetName="NodeIcon" Property="Fill" Value="{StaticResource Icon_Folder}"/>
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            
            <!-- Стилизация элементов TreeViewItem под темную тему -->
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Style.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A63"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1B3252"/>
                    </Style.Resources>
                    <Setter Property="IsExpanded" Value="True"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem x:Name="CopyNameMenuItem" Header="{DynamicResource ContextMenu_CopyName}" Click="CopyName_Click" />
                                <MenuItem x:Name="OpenInExplorerMenuItem" Header="{DynamicResource ContextMenu_OpenInExplorer}" Click="OpenInExplorer_Click" />
                                <MenuItem x:Name="RenameMenuItem" Header="{DynamicResource ContextMenu_Rename}" Click="Rename_Click" />
                                <MenuItem x:Name="DeleteMenuItem" Header="{DynamicResource ContextMenu_Delete}" Click="Delete_Click" />
                                <MenuItem x:Name="AddMenuItem" Header="{DynamicResource ContextMenu_Add}">
                                    <MenuItem Header="{DynamicResource ContextMenu_Folder}" Click="AddFolder_Click" />
                                </MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</UserControl>
