<UserControl x:Class="editor.Views.Widgets.AssetsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:infra="clr-namespace:editor.Services.Project.Infrastructure"
             xmlns:vm="clr-namespace:editor.ViewModels"
             xmlns:converters="clr-namespace:editor.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="AssetsWidget_Loaded"
             Unloaded="AssetsWidget_Unloaded"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    
    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Векторная иконка папки -->
        <VisualBrush x:Key="Icon_Folder" Stretch="Uniform">
            <VisualBrush.Visual>
                <Canvas Width="24" Height="24">
                    <Path Fill="#FFE0A96D" Data="M10 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2h-8l-2-2z"/>
                </Canvas>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- Векторная иконка файла -->
        <VisualBrush x:Key="Icon_File" Stretch="Uniform">
            <VisualBrush.Visual>
                <Canvas Width="24" Height="24">
                    <Path Fill="#FF90A4AE" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                </Canvas>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- Векторная иконка скрипта (зеленый свиток/код) -->
        <VisualBrush x:Key="Icon_Script" Stretch="Uniform">
            <VisualBrush.Visual>
                <Canvas Width="24" Height="24">
                    <Path Fill="#FF4CAF50" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                </Canvas>
            </VisualBrush.Visual>
        </VisualBrush>

         <!-- Стиль для ToggleButton в стиле тулбара -->
        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Checked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для MenuItem в шапке (Кнопка-меню фильтра) -->
        <Style x:Key="FlatMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom">
                                <Border Background="{DynamicResource Brush_Panel_Background}"
                                        BorderBrush="{DynamicResource Brush_Border}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="2">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для Button в стиле тулбара -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

         <!-- Стиль для SystemExpander -->
        <Style x:Key="SystemExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="ContentRow" Height="0"/>
                            </Grid.RowDefinitions>
                            
                            <ToggleButton x:Name="HeaderButton"
                                          Grid.Row="0"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{DynamicResource Brush_Panel_Header}"
                                          BorderBrush="{DynamicResource Brush_Border}"
                                          BorderThickness="0,1,0,1"
                                          Height="24"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path x:Name="Arrow"
                                                          Data="M 0 4 L 4 0 L 8 4"
                                                          Stroke="{DynamicResource Brush_Text_Primary}"
                                                          StrokeThickness="1.5"
                                                          Fill="Transparent"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"/>
                                                    <TextBlock Text="{DynamicResource Widget_Assets_SystemFiles}" 
                                                               Foreground="{DynamicResource Brush_Text_Primary}" 
                                                               FontWeight="Bold" 
                                                               FontSize="10" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush_Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 4 4 L 8 0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <Border x:Name="ContentBorder"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    Visibility="Collapsed">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentRow" Property="Height" Value="*"/>
                                <Setter TargetName="ContentBorder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush_Panel_Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления (Toolbar) -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush_Panel_Header}"
                BorderBrush="{DynamicResource Brush_Border}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">

                <!-- Фильтр обязательных папок (Плоская кнопка с иконкой воронки) -->
                <Menu Background="Transparent" Margin="2,0">
                    <MenuItem Style="{StaticResource FlatMenuItemStyle}" Cursor="Hand">
                        <MenuItem.ToolTip>
                            <ToolTip Content="{DynamicResource Widget_Assets_FilterResourceTypes}" Background="#2D2D30" Foreground="{DynamicResource Brush_Text_Primary}" BorderBrush="{DynamicResource Brush_Border}"/>
                        </MenuItem.ToolTip>
                        <MenuItem.Header>
                            <Path Data="M3,5 L21,5 L14,12 L14,19 L10,19 L10,12 Z" Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="16" Height="16"/>
                        </MenuItem.Header>
                        <MenuItem.ItemsSource>
                            <Binding Path="AvailableFilters"/>
                        </MenuItem.ItemsSource>
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" 
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Foreground="{DynamicResource Brush_Text_Primary}"
                                                      Margin="4,2"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="StaysOpenOnClick" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="BgBorder" Background="Transparent" SnapsToDevicePixels="True" CornerRadius="3" Padding="2">
                                                <ContentPresenter ContentSource="Header" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource Brush_Hover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                </Menu>

                <!-- Кнопка сброса фильтра для текущего дерева -->
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ResetFiltersCommand}" Margin="2,0">
                    <Button.ToolTip>
                        <ToolTip Content="{DynamicResource Widget_Assets_ResetFilters}" Background="#2D2D30" Foreground="{DynamicResource Brush_Text_Primary}" BorderBrush="{DynamicResource Brush_Border}"/>
                    </Button.ToolTip>
                    <Path Data="M2,4 L14,4 L9,9 L9,15 L7,15 L7,9 Z M13,10 L17,14 M17,10 L13,14"
                          Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="16" Height="16"/>
                </Button>

            </StackPanel>

                <!-- Поиск по имени - действует только на дерево ассетов (AssetsTree), не на System -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,5,0">
                    <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style_SearchTextBox}" HorizontalAlignment="Stretch" />
                    <Path Data="M15.5,14 L14.3,14 L13.9,13.6 C15.4,11.9 16,9.6 15.3,7.2 C14.3,3.8 11.4,1 8,0.3 C3.4,-0.6 -0.6,3.4 0.3,8 C1,11.4 3.8,14.3 7.2,15.3 C9.6,16 11.9,15.4 13.6,13.9 L14,14.3 L14,15.5 L19,20.5 L20.5,19 L15.5,14 Z M8,12 C5.8,12 4,10.2 4,8 C4,5.8 5.8,4 8,4 C10.2,4 12,5.8 12,8 C12,10.2 10.2,12 8,12 Z"
                          Fill="{DynamicResource Brush_Text_Secondary}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" Margin="6,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Область просмотра -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" /> <!-- Row for Assets TreeView -->
                <RowDefinition Height="Auto" /> <!-- Row for Expander (System) -->
            </Grid.RowDefinitions>

            <!-- Дерево ассетов (Assets Mode) -->
            <TreeView x:Name="AssetsTree"
                      Grid.Row="0"
                      ItemsSource="{Binding AssetRootNodes}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="5"
                      SelectedItemChanged="TreeView_SelectedItemChanged"
                      ContextMenuOpening="TreeView_ContextMenuOpening"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="AssetsTree_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="AssetsTree_PreviewMouseMove"
                      DragOver="AssetsTree_DragOver"
                      DragLeave="AssetsTree_DragLeave"
                      Drop="AssetsTree_Drop">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource ContextMenu_Folder}" Click="AddFolderToRoot_Click" />
                        <Separator />
                        <MenuItem Header="Script (MonoBehaviour)" Tag="Script" Click="AddScriptToRoot_Click" />
                        <MenuItem Header="Game Script" Tag="Game" Click="AddScriptToRoot_Click" />
                        <MenuItem Header="Scene Script" Tag="Scene" Click="AddScriptToRoot_Click" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type infra:ProjectNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Rectangle x:Name="NodeIcon" Width="14" Height="14" Margin="0,0,6,0" Fill="{StaticResource Icon_File}" PreviewMouseLeftButtonDown="NodeText_PreviewMouseLeftButtonDown"/>
                            <Grid>
                                <TextBlock x:Name="NodeText" Text="{Binding DisplayName}" Foreground="{DynamicResource Brush_Text_Primary}" VerticalAlignment="Center" Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}" PreviewMouseLeftButtonDown="NodeText_PreviewMouseLeftButtonDown"/>
                                <TextBox x:Name="NodeEditTextBox" Text="{Binding DisplayName, Mode=OneTime}" Foreground="{DynamicResource Brush_Text_Primary}" Background="#252526" BorderBrush="#007ACC" BorderThickness="1" MinWidth="100" VerticalAlignment="Center" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" Loaded="NodeEditTextBox_Loaded" LostFocus="NodeEditTextBox_LostFocus" KeyDown="NodeEditTextBox_KeyDown"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" x:Name="ScriptButtons" Visibility="Collapsed" VerticalAlignment="Center">
                                <Button x:Name="BtnH" Content="H" Width="16" Height="14" FontSize="9" FontWeight="Bold" Background="#FF2D2D30" Foreground="#FFA0A0A0" BorderBrush="Transparent" Margin="2,0" Padding="0" Cursor="Hand" PreviewMouseLeftButtonDown="BtnH_PreviewMouseLeftButtonDown"/>
                                <Button x:Name="BtnCpp" Content="CPP" Width="26" Height="14" FontSize="9" FontWeight="Bold" Background="#FF2D2D30" Foreground="#FFA0A0A0" BorderBrush="Transparent" Margin="2,0" Padding="0" Cursor="Hand" PreviewMouseLeftButtonDown="BtnCpp_PreviewMouseLeftButtonDown"/>
                            </StackPanel>
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                <Setter TargetName="NodeIcon" Property="Fill" Value="{StaticResource Icon_Folder}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsScript}" Value="True">
                                <Setter TargetName="NodeIcon" Property="Fill" Value="{StaticResource Icon_Script}"/>
                                <Setter TargetName="ScriptButtons" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasCpp}" Value="False">
                                <Setter TargetName="BtnCpp" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- Пока узел редактируется (ввод имени нового скрипта), hpp/cpp ещё не
                                 созданы на диске - кнопки H/CPP открытия файлов в этот момент бессмысленны. -->
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="ScriptButtons" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Style.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A63"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1B3252"/>
                        </Style.Resources>
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <!-- Скрытие непрошедших поиск узлов - только для AssetsTree, см. AssetsViewModel.ApplySearchFilter -->
                        <Setter Property="Visibility" Value="{Binding IsSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Name="AddMenuItem" Header="{DynamicResource ContextMenu_Add}">
                                        <MenuItem Header="{DynamicResource ContextMenu_Folder}" Name="AddFolderMenuItem" />
                                        <Separator />
                                        <MenuItem Header="Script (MonoBehaviour)" Name="AddScriptMenuItem" Tag="Script" />
                                        <MenuItem Header="Game Script" Name="AddGameScriptMenuItem" Tag="Game" />
                                        <MenuItem Header="Scene Script" Name="AddSceneScriptMenuItem" Tag="Scene" />
                                    </MenuItem>
                                    <MenuItem Name="CopyNameMenuItem" Header="{DynamicResource ContextMenu_CopyName}" />
                                    <MenuItem Name="OpenInExplorerMenuItem" Header="{DynamicResource ContextMenu_OpenInExplorer}" />
                                    <MenuItem Name="DeleteMenuItem" Header="{DynamicResource ContextMenu_Delete}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <!-- Экспандер с системными файлами (System Mode) -->
            <Expander x:Name="SystemExpander"
                      Grid.Row="1"
                      Style="{StaticResource SystemExpanderStyle}"
                      IsExpanded="{Binding IsSystemMode, Mode=TwoWay}"
                      Background="Transparent">
                
                <!-- Дерево системных файлов -->
                <TreeView x:Name="SystemTree"
                          ItemsSource="{Binding SystemRootNodes}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="5"
                          SelectedItemChanged="TreeView_SelectedItemChanged"
                          ContextMenuOpening="TreeView_ContextMenuOpening">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type infra:ProjectNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Rectangle x:Name="NodeIcon" Width="14" Height="14" Margin="0,0,6,0" Fill="{StaticResource Icon_File}"/>
                                <Grid>
                                    <TextBlock x:Name="NodeText" Text="{Binding DisplayName}" Foreground="{DynamicResource Brush_Text_Primary}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter TargetName="NodeIcon" Property="Fill" Value="{StaticResource Icon_Folder}"/>
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A63"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1B3252"/>
                            </Style.Resources>
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Name="CopyNameMenuItem" Header="{DynamicResource ContextMenu_CopyName}" />
                                        <MenuItem Name="OpenInExplorerMenuItem" Header="{DynamicResource ContextMenu_OpenInExplorer}" />
                                        <MenuItem Name="DeleteMenuItem" Header="{DynamicResource ContextMenu_Delete}" />
                                        <MenuItem Name="AddMenuItem" Header="{DynamicResource ContextMenu_Add}">
                                            <MenuItem Header="{DynamicResource ContextMenu_Folder}" />
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
