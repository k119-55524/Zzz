<UserControl x:Class="editor.Views.Widgets.ConsoleWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:editor.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:ConsoleViewModel}"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Стиль для кнопок на тулбаре -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <!-- Уменьшаем размер кнопок действий с 28 до 24 -->
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Checked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ToggleButton фильтров -->
        <Style x:Key="SourceToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <!-- Увеличиваем ширину с 30 до 34, чтобы вместить более крупную иконку -->
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush_Checked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Общий стиль для CheckBox в выпадающем меню -->
        <Style x:Key="DropdownCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="4,3"/>
        </Style>

        <!-- Стиль для чекбоксов на тулбаре (прижатых к иконкам) -->
        <Style x:Key="ToolbarCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для разделителей на панели инструментов (тулбаре). 
             Задает фиксированные размеры, центрирование и выразительный цвет. -->
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Separator">
            <!-- Цвет разделителя: делаем его достаточно контрастным на темном фоне панели инструментов -->
            <Setter Property="Background" Value="#555555"/>
            <Setter Property="Width" Value="1"/>
            <!-- Фиксированная высота линии разделителя, чтобы она не растягивалась на всю высоту панели -->
            <Setter Property="Height" Value="16"/>
            <!-- Внешние отступы слева и справа для визуального разделения смежных групп элементов -->
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <!-- Переопределяем стандартный системный шаблон Separator для устранения размытия и дефолтных рамок -->
                        <Border Width="{TemplateBinding Width}" 
                                Height="{TemplateBinding Height}" 
                                Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush_Panel_Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Тулбар -->
        <Border Grid.Row="0" Background="{DynamicResource Brush_Panel_Header}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush_Border}" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Действия -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Очистить -->
                    <Button ToolTip="{DynamicResource Console_Clear}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ClearCommand}">
                        <Path Data="M3,6 L17,6 M5,6 L5,18 C5,19.1 5.9,20 7,20 L13,20 C14.1,20 15,19.1 15,18 L15,6 M8,6 L8,4 C8,3.4 8.4,3 9,3 L11,3 C11.6,3 12,3.4 12,4 L12,6" 
                              Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Margin="5"/>
                    </Button>
                    <!-- Выразительный разделитель после кнопки Clear -->
                    <Separator Style="{StaticResource ToolbarSeparatorStyle}"/>
                    
                    <!-- Развернуть всё -->
                    <Button ToolTip="{DynamicResource Console_ExpandAll}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ExpandAllCommand}">
                        <Path Data="M3,4 L10,11 L17,4 M3,9 L10,16 L17,9" 
                              Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" Margin="5"/>
                    </Button>
                    <!-- Свернуть всё -->
                    <Button ToolTip="{DynamicResource Console_CollapseAll}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CollapseAllCommand}">
                        <Path Data="M3,16 L10,9 L17,16 M3,11 L10,4 L17,11" 
                              Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" Margin="5"/>
                    </Button>
                    <!-- Выразительный разделитель после кнопок сворачивания/развертывания -->
                    <Separator Style="{StaticResource ToolbarSeparatorStyle}"/>

                    <!-- Экспорт всего -->
                    <Button ToolTip="{DynamicResource Console_ExportAll}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ExportAllCommand}">
                        <Path Data="M4,17 L4,19 C4,19.5 4.5,20 5,20 L15,20 C15.5,20 16,19.5 16,19 L16,17 M10,3 L10,14 M6,10 L10,14 L14,10" 
                              Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" Margin="5"/>
                    </Button>
                     <!-- Экспорт отфильтрованного (двухцветная иконка: стрелка загрузки и зеленый фильтр справа) -->
                     <Button ToolTip="{DynamicResource Console_ExportFiltered}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ExportFilteredCommand}">
                         <Grid>
                             <!-- Точная копия левого значка скачивания -->
                             <Path Data="M4,17 L4,19 C4,19.5 4.5,20 5,20 L15,20 C15.5,20 16,19.5 16,19 L16,17 M10,3 L10,14 M6,10 L10,14 L14,10" 
                                   Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" Margin="5"/>
                             
                             <!-- Зеленые полоски поверх справа -->
                             <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,3,3,0">
                                 <Border Background="#4CAF50" Width="6" Height="1.8" CornerRadius="0.9" Margin="0,0.8" HorizontalAlignment="Right"/>
                                 <Border Background="#4CAF50" Width="4" Height="1.8" CornerRadius="0.9" Margin="0,0.8" HorizontalAlignment="Right"/>
                                 <Border Background="#4CAF50" Width="2" Height="1.8" CornerRadius="0.9" Margin="0,0.8" HorizontalAlignment="Right"/>
                             </StackPanel>
                         </Grid>
                     </Button>
                    <!-- Выразительный разделитель перед группой фильтров источников -->
                    <Separator Style="{StaticResource ToolbarSeparatorStyle}"/>
                </StackPanel>

                <!-- Фильтры Источников -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                    <!-- Редактор (Editor) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <CheckBox IsChecked="{Binding EditorFilter.IsEnabled}" Style="{StaticResource ToolbarCheckBoxStyle}" Margin="4,0,0,0"/>
                        <Grid>
                            <ToggleButton x:Name="TglEditor" ToolTip="{DynamicResource Console_Filter_Editor}" Style="{StaticResource SourceToggleButtonStyle}" IsEnabled="{Binding EditorFilter.IsEnabled}" Margin="0,0,0,0">
                                <!-- Увеличиваем размер сетки иконки до 28x16, первая колонка (иконка) увеличена до 18 -->
                                <Grid Width="28" Height="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="10"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Иконка монитора/экрана -->
                                    <Path Grid.Column="0" Data="M2,3 H16 V11 H2 Z M5,14 H13 M9,11 V14" 
                                          Stroke="#007ACC" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditorFilter.IsEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Grid.Column="1" Data="M1,1 L3,3 L5,1" Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center" Margin="2,2,0,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=TglEditor, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=TglEditor}" Placement="Bottom" Margin="0,2,0,0">
                                <Border Background="{DynamicResource Brush_Panel_Background}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1" Padding="10,8" CornerRadius="4" MinWidth="130">
                                    <StackPanel DataContext="{Binding EditorFilter}">
                                        <CheckBox Content="Message" IsChecked="{Binding ShowMessage}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Warning" IsChecked="{Binding ShowWarning}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Error" IsChecked="{Binding ShowError}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Exception" IsChecked="{Binding ShowException}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Critical" IsChecked="{Binding ShowCritical}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Fatal" IsChecked="{Binding ShowFatal}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <!-- Движок (Engine) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <CheckBox IsChecked="{Binding EngineFilter.IsEnabled}" Style="{StaticResource ToolbarCheckBoxStyle}" Margin="4,0,0,0"/>
                        <Grid>
                            <ToggleButton x:Name="TglEngine" ToolTip="{DynamicResource Console_Filter_Engine}" Style="{StaticResource SourceToggleButtonStyle}" IsEnabled="{Binding EngineFilter.IsEnabled}" Margin="0,0,0,0">
                                <Grid Width="28" Height="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="10"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Детализированная иконка ДВС (Двигатель/Check Engine) -->
                                    <Path Grid.Column="0" Data="M 2,7 L 2,17 M 2,10 L 5,10 M 2,14 L 5,14 M 5,9 L 5,18 L 18,18 L 18,15 L 20,15 L 20,17 L 23,17 L 23,11 L 20,11 L 20,13 L 18,13 L 18,9 L 15,9 L 15,6 L 9,6 L 9,9 Z M 12,6 L 12,4 M 9,4 L 15,4" 
                                          Stroke="#4CAF50" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EngineFilter.IsEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Grid.Column="1" Data="M1,1 L3,3 L5,1" Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center" Margin="2,2,0,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=TglEngine, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=TglEngine}" Placement="Bottom" Margin="0,2,0,0">
                                <Border Background="{DynamicResource Brush_Panel_Background}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1" Padding="10,8" CornerRadius="4" MinWidth="130">
                                    <StackPanel DataContext="{Binding EngineFilter}">
                                        <CheckBox Content="Message" IsChecked="{Binding ShowMessage}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Warning" IsChecked="{Binding ShowWarning}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Error" IsChecked="{Binding ShowError}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Exception" IsChecked="{Binding ShowException}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Critical" IsChecked="{Binding ShowCritical}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Fatal" IsChecked="{Binding ShowFatal}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <!-- Скрипты (Scripts) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                        <CheckBox IsChecked="{Binding ScriptsFilter.IsEnabled}" Style="{StaticResource ToolbarCheckBoxStyle}" Margin="4,0,0,0"/>
                        <Grid>
                            <ToggleButton x:Name="TglScripts" ToolTip="{DynamicResource Console_Filter_Scripts}" Style="{StaticResource SourceToggleButtonStyle}" IsEnabled="{Binding ScriptsFilter.IsEnabled}" Margin="0,0,0,0">
                                <Grid Width="28" Height="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="10"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Иконка Скрипта / Свитка -->
                                    <Path Grid.Column="0" Data="M3,3 H12 A1,1 0 0 1 13,4 V13 A1,1 0 0 1 12,14 H3 A1,1 0 0 1 2,13 V4 A1,1 0 0 1 3,3 Z M5,6 H10 M5,9 H10 M5,12 H8" 
                                          Stroke="#E6A23C" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScriptsFilter.IsEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.35"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Grid.Column="1" Data="M1,1 L3,3 L5,1" Stroke="{DynamicResource Brush_Text_Primary}" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center" Margin="2,2,0,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=TglScripts, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=TglScripts}" Placement="Bottom" Margin="0,2,0,0">
                                <Border Background="{DynamicResource Brush_Panel_Background}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1" Padding="10,8" CornerRadius="4" MinWidth="130">
                                    <StackPanel DataContext="{Binding ScriptsFilter}">
                                        <CheckBox Content="Message" IsChecked="{Binding ShowMessage}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Warning" IsChecked="{Binding ShowWarning}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Error" IsChecked="{Binding ShowError}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Exception" IsChecked="{Binding ShowException}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Critical" IsChecked="{Binding ShowCritical}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                        <CheckBox Content="Fatal" IsChecked="{Binding ShowFatal}" Style="{StaticResource DropdownCheckBoxStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <!-- Выразительный разделитель после группы фильтров источников -->
                    <Separator Style="{StaticResource ToolbarSeparatorStyle}"/>
                </StackPanel>

                <!-- Поиск (Растягивается на все оставшееся пространство) -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,5,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Style_SearchTextBox}" HorizontalAlignment="Stretch" />
                    <Path Data="M15.5,14 L14.3,14 L13.9,13.6 C15.4,11.9 16,9.6 15.3,7.2 C14.3,3.8 11.4,1 8,0.3 C3.4,-0.6 -0.6,3.4 0.3,8 C1,11.4 3.8,14.3 7.2,15.3 C9.6,16 11.9,15.4 13.6,13.9 L14,14.3 L14,15.5 L19,20.5 L20.5,19 L15.5,14 Z M8,12 C5.8,12 4,10.2 4,8 C4,5.8 5.8,4 8,4 C10.2,4 12,5.8 12,8 C12,10.2 10.2,12 8,12 Z" 
                          Fill="{DynamicResource Brush_Text_Secondary}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" Margin="6,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Список логов. Использует свойство AlternationCount="2" для реализации зебровой раскраски -->
        <ListView x:Name="LogsListView" Grid.Row="1" ItemsSource="{Binding LogsView}" 
                  AlternationCount="2"
                  Background="Transparent" BorderThickness="0" Padding="0,2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Задаем чередующиеся цвета строк (зебра) для четных (0) и нечетных (1) элементов -->
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <!-- Базовый темно-серый фон для четных строк -->
                            <Setter Property="Background" Value="{DynamicResource Brush_Log_Even}"/>
                        </Trigger>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <!-- Чуть более светлый фон для нечетных строк, повышающий читаемость -->
                            <Setter Property="Background" Value="{DynamicResource Brush_Log_Odd}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- Подсветка строки при наведении мыши -->
                            <Setter Property="Background" Value="{DynamicResource Brush_Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <!-- Цвет выделенной строки -->
                            <Setter Property="Background" Value="{DynamicResource Brush_Checked}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MouseLeftButtonUp="LogItem_Click" Background="Transparent" Margin="0,1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Строка лога -->
                        <Grid Grid.Row="0" Margin="8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/> <!-- Иконка источника/типа -->
                                <ColumnDefinition Width="90"/> <!-- Время -->
                                <ColumnDefinition Width="*"/>  <!-- Краткий текст лога -->
                            </Grid.ColumnDefinitions>

                            <!-- Иконка источника и типа -->
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <!-- Иконка Редактора -->
                                <Path Data="M2,3 H16 V11 H2 Z M5,14 H13 M9,11 V14" 
                                      StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="14" Height="14"
                                      x:Name="IconEditor" Visibility="Collapsed"/>
                                <!-- Иконка ДВС (Двигатель/Check Engine) -->
                                <Path Data="M23,12 L20.5,12 L20.5,9 C20.5,8.17 19.83,7.5 19,7.5 L15.5,7.5 L15.5,5.5 C15.5,4.67 14.83,4 14,4 L10,4 C9.17,4 8.5,4.67 8.5,5.5 L8.5,7.5 L5,7.5 C4.17,7.5 3.5,8.17 3.5,9 L3.5,12 L1,12 C0.45,12 0,12.45 0,13 L0,15 C0,15.55 0.45,16 1,16 L3.5,16 L3.5,19 C3.5,19.83 4.17,20.5 5,20.5 L19,20.5 C19.83,20.5 20.5,19.83 20.5,19 L20.5,16 L23,16 C23.55,16 24,15.55 24,15 L24,13 C24,12.45 23.55,12 23,12 Z" 
                                      StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="14" Height="14"
                                      x:Name="IconEngine" Visibility="Collapsed"/>
                                <!-- Иконка Скрипта -->
                                <Path Data="M3,3 H12 A1,1 0 0 1 13,4 V13 A1,1 0 0 1 12,14 H3 A1,1 0 0 1 2,13 V4 A1,1 0 0 1 3,3 Z M5,6 H10 M5,9 H10 M5,12 H8" 
                                      StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="14" Height="14"
                                      x:Name="IconScripts" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Время -->
                            <TextBlock Grid.Column="1" Text="{Binding TimeFormatted}" 
                                       Foreground="{DynamicResource Brush_Text_Secondary}" 
                                       FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>

                            <!-- Краткий Текст сообщения -->
                            <TextBlock Grid.Column="2" Text="{Binding Text}" 
                                       x:Name="TxtMessage"
                                       Foreground="{DynamicResource Brush_Text_Light}" 
                                       FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Border Grid.Row="1" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" 
                                Background="{DynamicResource Brush_Log_Even}" BorderThickness="1" BorderBrush="{DynamicResource Brush_Border}" Margin="32,2,8,6" Padding="10" CornerRadius="4">
                            <TextBox Text="{Binding DetailsText, Mode=OneWay}" 
                                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush_Text_Primary}" 
                                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsReadOnly="True" 
                                     IsUndoEnabled="False" SelectionBrush="{DynamicResource Brush_Accent}"/>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <!-- Настройка иконки и цвета в зависимости от источника и уровня -->
                        <!-- Источник: Редактор -->
                        <DataTrigger Binding="{Binding Source}" Value="Editor">
                            <Setter TargetName="IconEditor" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconEditor" Property="Stroke" Value="#007ACC"/> <!-- Синий по умолчанию -->
                        </DataTrigger>
                        <!-- Источник: Движок -->
                        <DataTrigger Binding="{Binding Source}" Value="Engine">
                            <Setter TargetName="IconEngine" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconEngine" Property="Stroke" Value="#4CAF50"/> <!-- Зеленый по умолчанию -->
                        </DataTrigger>
                        <!-- Источник: Скрипты -->
                        <DataTrigger Binding="{Binding Source}" Value="Scripts">
                            <Setter TargetName="IconScripts" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconScripts" Property="Stroke" Value="#E6A23C"/> <!-- Оранжевый по умолчанию -->
                        </DataTrigger>
                        
                        <!-- Цвета уровней логирования -->
                        <!-- Предупреждение (Warning) -->
                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                            <Setter TargetName="IconEditor" Property="Stroke" Value="#E6A23C"/>
                            <Setter TargetName="IconEngine" Property="Stroke" Value="#E6A23C"/>
                            <Setter TargetName="IconScripts" Property="Stroke" Value="#E6A23C"/>
                            <Setter TargetName="TxtMessage" Property="Foreground" Value="#E6A23C"/>
                        </DataTrigger>
                        <!-- Ошибки (Error, Exception, Critical, Fatal) -->
                        <DataTrigger Binding="{Binding Level}" Value="Error">
                            <Setter TargetName="IconEditor" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="IconEngine" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="IconScripts" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="TxtMessage" Property="Foreground" Value="#F56C6C"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Exception">
                            <Setter TargetName="IconEditor" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="IconEngine" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="IconScripts" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="TxtMessage" Property="Foreground" Value="#F56C6C"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Critical">
                            <Setter TargetName="IconEditor" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="IconEngine" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="IconScripts" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="TxtMessage" Property="Foreground" Value="#F56C6C"/>
                            <Setter TargetName="TxtMessage" Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="Fatal">
                            <Setter TargetName="IconEditor" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="IconEngine" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="IconScripts" Property="Stroke" Value="#F56C6C"/>
                            <Setter TargetName="TxtMessage" Property="Foreground" Value="#F56C6C"/>
                            <Setter TargetName="TxtMessage" Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

