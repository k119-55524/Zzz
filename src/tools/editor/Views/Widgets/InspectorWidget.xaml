<UserControl x:Class="editor.Views.Widgets.InspectorWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.expression/blend/2008" 
             xmlns:vm="clr-namespace:editor.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <Style x:Key="StatsContainerStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowFolderStats}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TomlPropertiesContainerStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowTomlProperties}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Специальный стиль для текстового поля поиска в инспекторе (по аналогии с логами) -->
        <Style x:Key="InspectorSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#060B13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,4,22,4" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#555555" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush_Text_Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="0" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                                
                                <Button x:Name="ClearButton" Grid.Column="1"
                                        Margin="0,0,6,0"
                                        Width="12" Height="12"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Focusable="False"
                                        Visibility="Visible"
                                        Click="ClearSearch_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <Path Data="M1,1 L11,11 M11,1 L1,11" 
                                                      Stroke="{DynamicResource Brush_Text_Secondary}" 
                                                      StrokeThickness="1.5" 
                                                      Stretch="Uniform" 
                                                      Margin="2"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2C08D" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2C08D" />
                                <Setter Property="Background" Value="#0D1929" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Light}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush_Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush_Checked}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Secondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Light}" />
            <Setter Property="Background" Value="{DynamicResource Brush_Panel_Header}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource InspectorComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="6,0,4,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  RecognizesAccessKey="True"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}" />
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="5"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Fill="{DynamicResource Brush_Text_Secondary}"
                                                      Data="M0,0 L4,5 L8,0 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Brush_Text_Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Brush_Text_Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush_Panel_Background}"
                                        BorderBrush="{DynamicResource Brush_Border}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush_Panel_Header}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Light}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush_Hover}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Brush_Text_Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Brush_Checked}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorCollectionListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush_Text_Light}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="0"
                                Margin="0,0,0,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Специально без триггера IsSelected - SelectedCollectionItem это чисто
                                 внутреннее состояние (для delete/add/drag), пользователю не нужно
                                 видеть жёлтую рамку "выделения" на элементе списка дефайнов/скриптов. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush_Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush_Panel_Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления (показывается только при загруженном проекте) -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush_Panel_Header}"
                BorderBrush="{DynamicResource Brush_Border}"
                BorderThickness="0,0,0,1"
                Padding="12,5"
                Visibility="{Binding IsProjectOpen, Converter={StaticResource BoolToVis}}">
            <Grid Height="24">
                <!-- Поиск/Фильтр по аналогии с логами -->
                <Grid VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InspectorSearchTextBoxStyle}" HorizontalAlignment="Stretch" />
                    <Path Data="M15.5,14 L14.3,14 L13.9,13.6 C15.4,11.9 16,9.6 15.3,7.2 C14.3,3.8 11.4,1 8,0.3 C3.4,-0.6 -0.6,3.4 0.3,8 C1,11.4 3.8,14.3 7.2,15.3 C9.6,16 11.9,15.4 13.6,13.9 L14,14.3 L14,15.5 L19,20.5 L20.5,19 L15.5,14 Z M8,12 C5.8,12 4,10.2 4,8 C4,5.8 5.8,4 8,4 C10.2,4 12,5.8 12,8 C12,10.2 10.2,12 8,12 Z" 
                          Fill="{DynamicResource Brush_Text_Secondary}" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Left" Margin="6,0,0,0" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Основное содержимое инспектора -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Колонки для регулирования ширины имени и значения с помощью сплиттера -->
                <ColumnDefinition Width="150" MinWidth="80" x:Name="ColName"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>



        <!-- Statistics View (занимает всю ширину, внутренние сетки привязаны к ColName) -->
        <Grid Grid.ColumnSpan="3" Style="{StaticResource StatsContainerStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,16" DataContext="{Binding}">
                    <!-- Table Header -->
                    <Border Background="{DynamicResource Brush_Window_Background}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ElementName=ColName, Path=Width}"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Inspector_Table_Name}" Foreground="{DynamicResource Brush_Text_Secondary}" FontWeight="SemiBold" FontSize="12" Margin="16,0,0,0"/>
                            <Rectangle Grid.Column="1" Width="1" VerticalAlignment="Stretch" Fill="#555555" Margin="0,2"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Inspector_Table_Value}" Foreground="{DynamicResource Brush_Text_Secondary}" FontWeight="SemiBold" FontSize="12" Margin="8,0,16,0"/>
                        </Grid>
                    </Border>

                    <!-- Info Grid -->
                    <Grid DataContext="{Binding FolderStats}">
                        <Grid.ColumnDefinitions>
                            <!-- Ширина колонки имени жестко связана с мастер-колонкой ColName -->
                            <ColumnDefinition Width="{Binding ElementName=ColName, Path=Width}"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Чередующиеся фоны строк (зебра) -->
                        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource Brush_Log_Even}" Padding="0,6"/>
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource Brush_Log_Odd}" Padding="0,6"/>
                        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{DynamicResource Brush_Log_Even}" Padding="0,6"/>
                        <Border Grid.Row="3" Grid.ColumnSpan="3" Background="{DynamicResource Brush_Log_Odd}" Padding="0,6"/>
                        <Border Grid.Row="4" Grid.ColumnSpan="3" Background="{DynamicResource Brush_Log_Even}" Padding="0,6"/>

                        <!-- Row 0: Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Inspector_Stats_Name}" Foreground="{DynamicResource Brush_Text_Secondary}" Margin="16,6,8,6" VerticalAlignment="Center" FontSize="13" Panel.ZIndex="1"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource Brush_Text_Light}" Margin="8,6,16,6" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Panel.ZIndex="1"/>

                        <!-- Row 1: Path -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Inspector_Stats_Path}" Foreground="{DynamicResource Brush_Text_Secondary}" Margin="16,6,8,6" VerticalAlignment="Center" FontSize="13" Panel.ZIndex="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Path}" Foreground="{DynamicResource Brush_Text_Light}" Margin="8,6,16,6" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Panel.ZIndex="1"/>

                        <!-- Row 2: Subfolders -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Inspector_Stats_Subfolders}" Foreground="{DynamicResource Brush_Text_Secondary}" Margin="16,6,8,6" VerticalAlignment="Center" FontSize="13" Panel.ZIndex="1"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SubfoldersCount}" Foreground="{DynamicResource Brush_Text_Light}" Margin="8,6,16,6" VerticalAlignment="Center" FontSize="13" Panel.ZIndex="1"/>

                        <!-- Row 3: Files -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Inspector_Stats_Files}" Foreground="{DynamicResource Brush_Text_Secondary}" Margin="16,6,8,6" VerticalAlignment="Center" FontSize="13" Panel.ZIndex="1"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding FilesCount}" Foreground="{DynamicResource Brush_Text_Light}" Margin="8,6,16,6" VerticalAlignment="Center" FontSize="13" Panel.ZIndex="1"/>

                        <!-- Row 4: Total Size -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Inspector_Stats_TotalSize}" Foreground="{DynamicResource Brush_Text_Secondary}" Margin="16,6,8,6" VerticalAlignment="Center" FontSize="13" Panel.ZIndex="1"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding TotalSizeFormatted}" Foreground="{DynamicResource Brush_Text_Light}" Margin="8,6,16,6" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Panel.ZIndex="1"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- TOML Properties View (занимает всю ширину, внутренние сетки привязаны к ColName) -->
        <Grid Grid.ColumnSpan="3" Style="{StaticResource TomlPropertiesContainerStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,16">
                    <!-- Table Header -->
                    <Border Background="{DynamicResource Brush_Window_Background}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ElementName=ColName, Path=Width}"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Inspector_Table_Name}" Foreground="{DynamicResource Brush_Text_Secondary}" FontWeight="SemiBold" FontSize="12" Margin="16,0,0,0"/>
                            <Rectangle Grid.Column="1" Width="1" VerticalAlignment="Stretch" Fill="#555555" Margin="0,2"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Inspector_Table_Value}" Foreground="{DynamicResource Brush_Text_Secondary}" FontWeight="SemiBold" FontSize="12" Margin="8,0,16,0"/>
                        </Grid>
                    </Border>

                    <!-- ItemsControl for properties -->
                    <ItemsControl ItemsSource="{Binding TomlProperties}" AlternationCount="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RowBorder" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Ширина колонки имени жестко связана с мастер-колонкой ColName -->
                                            <ColumnDefinition Width="{Binding ElementName=ColName, Path=Width}"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Текст заголовка выравнивается по верхней границе на случай многострочного значения -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Foreground="{DynamicResource Brush_Text_Secondary}"
                                                   VerticalAlignment="Top"
                                                   Margin="16,4,8,0"
                                                   FontSize="13"/>
                                                   
                                        <!-- Однострочное поле: применяется по потере фокуса или Enter (см. ValueTextBox_PreviewKeyDown) -->
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                 IsReadOnly="{Binding IsReadOnly}"
                                                 Background="{DynamicResource Brush_Panel_Header}"
                                                 Foreground="{DynamicResource Brush_Text_Light}"
                                                 BorderBrush="{DynamicResource Brush_Border}"
                                                 BorderThickness="1"
                                                 Padding="4,3"
                                                 Margin="8,0,16,0"
                                                 FontSize="13"
                                                 TextWrapping="NoWrap"
                                                 AcceptsReturn="False"
                                                 PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                                                 VerticalAlignment="Center">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStringValue}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsReadOnly" Value="True">
                                                            <Setter Property="Opacity" Value="0.6"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding OptionItems}"
                                                  SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="8,0,16,0"
                                                  FontSize="13"
                                                  VerticalAlignment="Center">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource InspectorComboBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>

                                        <StackPanel Grid.Column="2" Margin="8,0,16,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCollection}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <ListBox ItemsSource="{Binding CollectionItems}"
                                                     SelectedItem="{Binding SelectedCollectionItem, Mode=TwoWay}"
                                                     ItemContainerStyle="{StaticResource InspectorCollectionListBoxItemStyle}"
                                                     AlternationCount="2"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     AllowDrop="True"
                                                     PreviewMouseLeftButtonDown="CollectionListBox_PreviewMouseLeftButtonDown"
                                                     PreviewMouseMove="CollectionListBox_PreviewMouseMove"
                                                     Drop="CollectionListBox_Drop">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="28" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Ручка для drag-n-drop сортировки - перетаскивание начинается только с неё
                                                                 (см. InspectorWidget.CollectionListBox_PreviewMouseLeftButtonDown), иначе
                                                                 клик мышью по TextBox дефайна конфликтовал бы с постановкой курсора текста. -->
                                                            <TextBlock Grid.Column="0"
                                                                       Text="&#x22EE;"
                                                                       Tag="CollectionDragHandle"
                                                                       Foreground="{DynamicResource Brush_Text_Secondary}"
                                                                       FontWeight="Bold"
                                                                       Cursor="SizeAll"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       Width="16"
                                                                       Margin="0,0,4,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsSortableCollection, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                                     Foreground="{DynamicResource Brush_Text_Light}"
                                                                     BorderBrush="{DynamicResource Brush_Border}"
                                                                     BorderThickness="1"
                                                                     Padding="4,3"
                                                                     FontSize="13"
                                                                     PreviewKeyDown="ValueTextBox_PreviewKeyDown">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="Background" Value="{DynamicResource Brush_Panel_Header}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsStringCollection, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                            <!-- Чередующийся фон поля ввода дефайна - как в основной таблице
                                                                                 свойств инспектора (см. Brush_Log_Even/Odd в TomlProperties). -->
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush_Log_Even}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                                <Setter Property="Background" Value="{DynamicResource Brush_Log_Odd}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>

                                                            <Border Grid.Column="1"
                                                                    Background="{DynamicResource Brush_Panel_Header}"
                                                                    BorderBrush="{DynamicResource Brush_Border}"
                                                                    BorderThickness="1"
                                                                    Padding="6,3">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsAssetGuidCollection, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding DisplayValue}"
                                                                           Foreground="{DynamicResource Brush_Text_Light}"
                                                                           FontSize="13"
                                                                           VerticalAlignment="Center" />
                                                            </Border>

                                                            <Button Grid.Column="2"
                                                                    Content="x"
                                                                    Style="{StaticResource InspectorToolButtonStyle}"
                                                                    Command="{Binding DataContext.DeleteCollectionItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="4,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStringCollection}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="+"
                                                        Style="{StaticResource InspectorToolButtonStyle}"
                                                        Command="{Binding AddCollectionItemCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush_Log_Even}"/>
                                    </Trigger>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush_Log_Odd}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Reset/Apply на весь конфиг - активны, только пока есть черновые правки
                         коллекций (например, Defines). Apply фиксирует их и запускает пересборку
                         scripts.dll (см. InspectorViewModel.ApplyPendingChangesCommand/ResetPendingChangesCommand).
                         При уходе с этого файла в инспекторе показывается тот же выбор Apply/Reset
                         в виде диалога (см. CommitOrDiscardPendingChanges). -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,16,0">
                        <Button Content="{DynamicResource Inspector_Reset_Button}"
                                Style="{StaticResource InspectorToolButtonStyle}"
                                Command="{Binding ResetPendingChangesCommand}"
                                Margin="0,0,4,0"/>
                        <Button Content="{DynamicResource Inspector_Apply_Button}"
                                Style="{StaticResource InspectorToolButtonStyle}"
                                Command="{Binding ApplyPendingChangesCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <!-- Разделитель (сплиттер) для интерактивного изменения ширины колонок -->
        <GridSplitter Grid.Column="1" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" 
                      Background="Transparent" 
                      Cursor="SizeWE"/>
        </Grid>
    </Grid>
</UserControl>
