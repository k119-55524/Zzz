    <sys:String x:Key="Log_Engine_Init_Start">Starting engine initialization...</sys:String>
    <sys:String x:Key="Log_Engine_Init_Success">Engine initialized successfully.</sys:String>
    <sys:String x:Key="Log_Engine_Init_Fail">Failed to initialize engine.</sys:String>
    <sys:String x:Key="Log_Engine_Stop">Engine stopped.</sys:String>
    <sys:String x:Key="Log_Viewport_Init">Initializing viewport {0} (HWND: {1})</sys:String>
    <sys:String x:Key="Log_Viewport_Destroy">Destroying viewport {0} (HWND: {1})</sys:String>

