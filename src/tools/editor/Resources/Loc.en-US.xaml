    <sys:String x:Key="Msg_Project_NotFound_Title">Project Not Found</sys:String>
    <sys:String x:Key="Msg_Project_NotFound_Load">The last project at '{0}' was not found. Editor will start with no project.</sys:String>
    <sys:String x:Key="Msg_Project_NotFound_Recent">Project not found at '{0}'. It will be removed from the recent projects list.</sys:String>
    <sys:String x:Key="Msg_Error_Title">Error</sys:String>
    
