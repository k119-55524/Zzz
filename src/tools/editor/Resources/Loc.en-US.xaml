<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Menu & Common -->
    <sys:String x:Key="Menu_File">File</sys:String>
    <sys:String x:Key="Menu_File_Create">New Project</sys:String>
    <sys:String x:Key="Menu_File_Open">Open Project</sys:String>
    <sys:String x:Key="Menu_File_Close">Unload Project</sys:String>
    <sys:String x:Key="Menu_File_Recent">Recent Projects</sys:String>
    <sys:String x:Key="Menu_File_Exit">Exit</sys:String>
    
    <sys:String x:Key="Menu_Window">Window</sys:String>
    <sys:String x:Key="Menu_Window_Reset">Reset Layout</sys:String>
    <sys:String x:Key="Menu_File_NoProject">No Project</sys:String>
    
    <sys:String x:Key="Menu_Help">Help</sys:String>
    <sys:String x:Key="Menu_Help_About">About</sys:String>

    <!-- Widget Titles -->
    <sys:String x:Key="Widget_World_Title">World</sys:String>
    <sys:String x:Key="Widget_Game_Title">Game</sys:String>
    <sys:String x:Key="Widget_Inspector_Title">Inspector</sys:String>
    <sys:String x:Key="Widget_SceneTree_Title">Hierarchy</sys:String>
    <sys:String x:Key="Widget_Assets_Title">Project</sys:String>
    <sys:String x:Key="Widget_Console_Title">Console</sys:String>
    <sys:String x:Key="Widget_Settings_Title">Settings</sys:String>
    <sys:String x:Key="Widget_Build_Title">Build</sys:String>
    
    <!-- Widget Placeholders -->
    <sys:String x:Key="Widget_Inspector_Placeholder">PROPERTIES INSPECTOR</sys:String>
    <sys:String x:Key="Widget_SceneTree_Placeholder">SCENE HIERARCHY TREE</sys:String>
    <sys:String x:Key="Widget_Assets_Placeholder">ASSETS / FILE BROWSER</sys:String>
    <sys:String x:Key="Widget_Console_Placeholder">CONSOLE LOG OUTPUT</sys:String>
    <sys:String x:Key="Widget_Settings_Placeholder">PROJECT &amp; EDITOR SETTINGS</sys:String>
    <sys:String x:Key="Widget_Build_Placeholder">BUILD &amp; EXPORT CONFIGURATION</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dialog_About_Title">About ZzzEditor</sys:String>
    <sys:String x:Key="Dialog_About_Message">Zzz Engine Game Editor</sys:String>
    <sys:String x:Key="Dialog_About_Version">Version: {0}</sys:String>
    <sys:String x:Key="Dialog_Close_Title">Exit Editor</sys:String>
    <sys:String x:Key="Dialog_Close_Unsaved">Save project changes before exiting?</sys:String>

    <!-- Project Errors & Warnings -->
    <sys:String x:Key="Msg_Project_NotFound_Title">Project Not Found</sys:String>
    <sys:String x:Key="Msg_Project_NotFound_Load">The last project at '{0}' was not found. Editor will start with no project.</sys:String>
    <sys:String x:Key="Msg_Project_NotFound_Recent">Project not found at '{0}'. It will be removed from the recent projects list.</sys:String>
    <sys:String x:Key="Msg_Error_Title">Error</sys:String>
    
    <!-- Project Creation & Validation -->
    <sys:String x:Key="Validation_ProjectName_Empty">Project name cannot be empty.</sys:String>
    <sys:String x:Key="Validation_ProjectName_InvalidChars">Project name contains invalid characters.</sys:String>
    <sys:String x:Key="Validation_Folder_Exists">Folder '{0}' already exists at the specified location and is not empty.</sys:String>
    <sys:String x:Key="Validation_Folder_NotExist">The specified project folder does not exist.</sys:String>
    <sys:String x:Key="Validation_Create_Failed">Failed to create project: {0}</sys:String>
    <sys:String x:Key="Validation_Load_Failed">Error loading project: {0}</sys:String>
    
    <!-- NewProjectDialog Texts -->
    <sys:String x:Key="Dialog_NewProject_Title">New Project</sys:String>
    <sys:String x:Key="Dialog_NewProject_Name">Project Name:</sys:String>
    <sys:String x:Key="Dialog_NewProject_Location">Location:</sys:String>
    <sys:String x:Key="Dialog_NewProject_Browse">Browse...</sys:String>
    <sys:String x:Key="Dialog_NewProject_Create">Create</sys:String>
    <sys:String x:Key="Dialog_NewProject_Cancel">Cancel</sys:String>
    <sys:String x:Key="Dialog_OpenProject_Title">Open Project</sys:String>
    <sys:String x:Key="Dialog_NewProject_BrowseFolder_Title">Select project folder</sys:String>

    <!-- Viewport Toolbars (World & Game) -->
    <sys:String x:Key="Toolbar_Translate">Translate (W)</sys:String>
    <sys:String x:Key="Toolbar_Rotate">Rotate (E)</sys:String>
    <sys:String x:Key="Toolbar_Scale">Scale (R)</sys:String>
    <sys:String x:Key="Toolbar_GridSnap">Grid Snapping</sys:String>
    <sys:String x:Key="Toolbar_Play">Play Game</sys:String>
    <sys:String x:Key="Toolbar_Pause">Pause</sys:String>
    <sys:String x:Key="Toolbar_Stop">Stop</sys:String>
    <sys:String x:Key="Toolbar_Mute">Mute Audio</sys:String>
    <sys:String x:Key="Toolbar_CamSpeed">Camera Speed</sys:String>
</ResourceDictionary>
