    <sys:String x:Key="LogLevel_Message">Message</sys:String>
    <sys:String x:Key="LogLevel_Warning">Warning</sys:String>
    <sys:String x:Key="LogLevel_Error">Error</sys:String>
    <sys:String x:Key="LogLevel_Exception">Exception</sys:String>
    <sys:String x:Key="LogLevel_Critical">Critical Error</sys:String>
    <sys:String x:Key="LogLevel_Fatal">Fatal Error</sys:String>
