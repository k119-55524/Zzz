    <sys:String x:Key="Console_Details_Time">Time</sys:String>
    <sys:String x:Key="Console_Details_Source">Source</sys:String>
    <sys:String x:Key="Console_Details_Level">Level</sys:String>
    <sys:String x:Key="Console_Details_Message">Message</sys:String>
    <sys:String x:Key="Console_Details_File">File</sys:String>
    <sys:String x:Key="Console_Details_Function">Function</sys:String>
    <sys:String x:Key="Console_Details_Line">Line</sys:String>

