<Window x:Class="assets_builder_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" 
        Height="{Binding WindowHeight, Mode=TwoWay}" 
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Left="{Binding WindowLeft, Mode=TwoWay}"
        Top="{Binding WindowTop, Mode=TwoWay}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="False"
        Icon="pack://application:,,,/Properties/AppIcon.ico"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextLight}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="MaximizeWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="RestoreWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="CloseWindow_Executed" />
    </Window.CommandBindings>

    <!-- Внешняя желтая рамка в стиле редактора -->
    <Border BorderBrush="{StaticResource TextPrimary}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" /> <!-- Кастомная шапка -->
                <RowDefinition Height="*" />  <!-- Основное содержимое -->
                <RowDefinition Height="26" /> <!-- Панель состояния внизу -->
            </Grid.RowDefinitions>

            <!-- 1. Кастомная шапка (TitleBar) -->
            <Border Grid.Row="0" Background="{StaticResource PanelHeaderBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Иконка и заголовок -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Image Source="pack://application:,,,/Properties/AppIcon.ico" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WindowTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Кнопки управления окном (Свернуть, Развернуть, Закрыть) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ChromeButtonStyle}" 
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}" 
                                ToolTip="Свернуть">
                            <TextBlock Text="─" FontSize="10" Foreground="{StaticResource TextLight}"/>
                        </Button>
                        
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource ChromeButtonStyle}" 
                                Command="{x:Static SystemCommands.MaximizeWindowCommand}" 
                                ToolTip="Развернуть">
                            <TextBlock Text="🗖" FontSize="11" Foreground="{StaticResource TextLight}"/>
                        </Button>

                        <Button x:Name="RestoreButton"
                                Style="{StaticResource ChromeButtonStyle}" 
                                Command="{x:Static SystemCommands.RestoreWindowCommand}" 
                                ToolTip="Восстановить"
                                Visibility="Collapsed">
                            <TextBlock Text="🗗" FontSize="11" Foreground="{StaticResource TextLight}"/>
                        </Button>

                        <Button Style="{StaticResource ChromeCloseButtonStyle}" 
                                Command="{x:Static SystemCommands.CloseWindowCommand}" 
                                ToolTip="Закрыть">
                            <TextBlock Text="✕" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Центральное окно UI -->
            <Grid Grid.Row="1" Background="{StaticResource PanelBackground}" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="130" /> <!-- 1. Список настроек + кнопки -->
                    <RowDefinition Height="Auto" /> <!-- 2. Разделитель -->
                    <RowDefinition Height="Auto" /> <!-- 3. Редактор текущей настройки -->
                    <RowDefinition Height="Auto" /> <!-- 4. Кнопка Старт Сборки -->
                    <RowDefinition Height="*" />    <!-- 5. Панель Логов -->
                </Grid.RowDefinitions>

                <!-- 1. Список настроек с прокруткой и кнопками -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox ItemsSource="{Binding ProfilesView}" 
                             SelectedItem="{Binding SelectedProfile}"
                             Background="#0A1321" 
                             BorderBrush="{StaticResource BorderBrush}" 
                             BorderThickness="1" 
                             Margin="0,0,0,6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextLight}" Padding="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Кнопки под списком -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="+ Добавить" Command="{Binding AddProfileCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="🗑 Удалить выделенное" Command="{Binding DeleteProfileCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Разделитель -->
                <Separator Grid.Row="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,10"/>

                <!-- 3. Редактор выделенной настройки -->
                <Grid Grid.Row="2" IsEnabled="{Binding HasSelectedProfile}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- а. Имя настройки -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Имя настройки:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}" MaxLength="255"/>
                    </Grid>

                    <!-- б. Путь к скриптам -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Путь к скриптам:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedProfile.ScriptsPath, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource PathTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProfile.IsScriptsPathValid}" Value="False">
                                            <Setter Property="Foreground" Value="#FF5252" />
                                            <Setter Property="BorderBrush" Value="#FF5252" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Content="📂 Обзор..." Command="{Binding BrowseScriptsPathCommand}" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- в. Путь к ассетам -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Путь к ассетам:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedProfile.AssetsPath, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource PathTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProfile.IsAssetsPathValid}" Value="False">
                                            <Setter Property="Foreground" Value="#FF5252" />
                                            <Setter Property="BorderBrush" Value="#FF5252" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Content="📂 Обзор..." Command="{Binding BrowseAssetsPathCommand}" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- г. Путь назначения -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Путь назначения:" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedProfile.DestinationPath, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource PathTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProfile.IsDestinationPathValid}" Value="False">
                                            <Setter Property="Foreground" Value="#FF5252" />
                                            <Setter Property="BorderBrush" Value="#FF5252" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2" Content="📂 Обзор..." Command="{Binding BrowseDestinationPathCommand}" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- д. Кнопки Сохранить и Отмена -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="↩ Отмена" Command="{Binding CancelProfileCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="💾 Сохранить" Command="{Binding SaveProfileCommand}" Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- 4. Кнопка Старт/Прерывание сборки справа -->
                <Grid Grid.Row="3" Margin="0,10,0,10">
                    <Button Content="{Binding BuildButtonText}" 
                            Command="{Binding StartOrCancelBuildCommand}" 
                            Style="{StaticResource AccentButtonStyle}" 
                            HorizontalAlignment="Right" 
                            FontSize="13" 
                            Padding="16,6"/>
                </Grid>

                <!-- 5. Панель логов сборки -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Логи сборки:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📋 Скопировать логи" Command="{Binding CopyLogsCommand}" Style="{StaticResource ActionButtonStyle}" Padding="8,2" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="🗑 Очистить логи" Command="{Binding ClearLogsCommand}" Style="{StaticResource ActionButtonStyle}" Padding="8,2" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <TextBox Grid.Row="1" 
                             Text="{Binding LogText}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" 
                             Background="#0A1321" 
                             Foreground="#CDD9E5" 
                             FontFamily="Consolas" 
                             FontSize="11" 
                             BorderBrush="{StaticResource BorderBrush}" 
                             BorderThickness="1" 
                             Padding="6"/>
                </Grid>
            </Grid>

            <!-- 3. Панель состояния (Status Bar) -->
            <Border Grid.Row="2" Background="{StaticResource PanelHeaderBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Статус слева -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Версия справа -->
                    <TextBlock Grid.Column="1" Text="v1.0.0" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
