<Window x:Class="assets_builder_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" 
        Height="{Binding WindowHeight, Mode=TwoWay}" 
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Left="{Binding WindowLeft, Mode=TwoWay}"
        Top="{Binding WindowTop, Mode=TwoWay}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="False"
        Icon="pack://application:,,,/Properties/AppIcon.ico"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextLight}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="MaximizeWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="RestoreWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="CloseWindow_Executed" />
    </Window.CommandBindings>

    <!-- Внешняя желтая рамка в стиле редактора -->
    <Border BorderBrush="{StaticResource TextPrimary}" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" /> <!-- Кастомная шапка -->
                <RowDefinition Height="*" />  <!-- Основное содержимое -->
                <RowDefinition Height="26" /> <!-- Панель состояния внизу -->
            </Grid.RowDefinitions>

            <!-- 1. Кастомная шапка (TitleBar) -->
            <Border Grid.Row="0" Background="{StaticResource PanelHeaderBackground}" BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="0,0,0,1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Иконка и заголовок -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Image Source="pack://application:,,,/Properties/AppIcon.ico" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WindowTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Кнопки управления окном (Свернуть, Развернуть, Закрыть) -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButtonStyle}" 
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}" 
                                ToolTip="Свернуть">
                            <TextBlock Text="─" FontSize="10" Foreground="{StaticResource TextLight}"/>
                        </Button>
                        
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource ChromeButtonStyle}" 
                                Command="{x:Static SystemCommands.MaximizeWindowCommand}" 
                                ToolTip="Развернуть">
                            <TextBlock Text="🗖" FontSize="11" Foreground="{StaticResource TextLight}"/>
                        </Button>

                        <Button x:Name="RestoreButton"
                                Style="{StaticResource ChromeButtonStyle}" 
                                Command="{x:Static SystemCommands.RestoreWindowCommand}" 
                                ToolTip="Восстановить"
                                Visibility="Collapsed">
                            <TextBlock Text="🗗" FontSize="11" Foreground="{StaticResource TextLight}"/>
                        </Button>

                        <Button Style="{StaticResource ChromeCloseButtonStyle}" 
                                Command="{x:Static SystemCommands.CloseWindowCommand}" 
                                ToolTip="Закрыть">
                            <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextLight}" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Центральное окно UI -->
            <Grid Grid.Row="1" Background="{StaticResource PanelBackground}" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- БЛОК 1: Выбор проекта + действия -->
                    <RowDefinition x:Name="PresetsRow" Height="260" MinHeight="170" /> <!-- БЛОК 2: Наборы сборки и таргеты -->
                    <RowDefinition Height="7" />    <!-- Сплиттер регулировки высоты -->
                    <RowDefinition x:Name="LogsRow" Height="*" MinHeight="120" /> <!-- БЛОК 3: Панель Логов -->
                    <RowDefinition Height="Auto" /> <!-- Кнопки действий в самом низу -->
                </Grid.RowDefinitions>

                <!-- ========================================================================= -->
                <!--  БЛОК 1: ВЫБОР ПРОЕКТА И УПРАВЛЕНИЕ                                       -->
                <!-- ========================================================================= -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Строка 1: [ Выпадающий список ]  Комментарий / описание -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" 
                                  ItemsSource="{Binding ProfilesView}" 
                                  SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding SelectedProfile.ProjectDescription}" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   VerticalAlignment="Center" 
                                   Margin="12,0,0,0" 
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedProfile.ProjectDescription}"/>
                    </Grid>

                    <!-- Строка 2: Полный путь к проекту под выпадающим списком -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Путь к проекту:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11" Margin="2,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedProfile.SourcePath}" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>

                <!-- ========================================================================= -->
                <!--  БЛОК 2: НАБОРЫ СБОРКИ                                                    -->
                <!-- ========================================================================= -->
                <Border Grid.Row="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BlockCardStyle}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Margin" Value="0,6,0,0"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSelectedProfile}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Шапка Блока 2 -->
                        <Border Grid.Row="0" Style="{StaticResource BlockHeaderStyle}">
                            <TextBlock Text="НАБОРЫ СБОРКИ" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11"/>
                        </Border>

                        <!-- Содержимое Блока 2 -->
                        <Grid Grid.Row="1" Margin="10,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Ошибки строгой валидации структуры проекта -->
                            <Border Grid.Row="0" 
                                    Background="#3A1515" 
                                    BorderBrush="#FF5252" 
                                    BorderThickness="1" 
                                    CornerRadius="3" 
                                    Padding="8,4" 
                                    Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProfile.IsProjectValid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="⚠ ОШИБКА ВАЛИДАЦИИ СТРУКТУРЫ ПРОЕКТА (Сборка заблокирована):" Foreground="#FF5252" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedProfile.ValidationErrorsSummary}" Foreground="#FFC107" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Набор сборки (Preset Selector) + Таблица целевых проектов (Targets) -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <!-- Селектор пресета -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Набор сборки:" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SelectedProfile.Presets}"
                                              SelectedItem="{Binding SelectedProfile.SelectedPreset}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource DarkComboBoxStyle}"/>
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding SelectedProfile.SelectedPreset.Description}" 
                                               Foreground="{StaticResource TextSecondary}" 
                                               VerticalAlignment="Center" 
                                               Margin="12,0,0,0" 
                                               FontSize="11"/>
                                </Grid>

                                <!-- Заголовок таблицы таргетов -->
                                <Border Grid.Row="1" Background="#161B22" BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="1,1,1,0" Padding="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Конфигурация" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="Папка целевого проекта" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0"/>
                                        <TextBlock Grid.Column="2" Text="Платформа" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="4,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Список таргетов выбранного набора сборки -->
                                <Border Grid.Row="2" Background="#060B13" BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="1" Padding="4" MinHeight="70">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedProfile.SelectedPreset.Targets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="190" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Конфигурация платформы: ComboBox (None = не собирается) -->
                                                        <ComboBox Grid.Column="0" 
                                                                  ItemsSource="{Binding AvailableConfigOptions}" 
                                                                  SelectedItem="{Binding SelectedConfigOption, Mode=TwoWay}" 
                                                                  DisplayMemberPath="DisplayName" 
                                                                  Style="{StaticResource DarkComboBoxStyle}" 
                                                                  Margin="0,0,6,0"
                                                                  FontSize="11"
                                                                  ToolTip="{Binding ConfigFilePath}"/>

                                                        <!-- Папка целевого проекта: путь + кнопка обзора -->
                                                        <Grid Grid.Column="1" Margin="0,0,6,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" 
                                                                     Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Style="{StaticResource PathTextBoxStyle}"
                                                                     FontSize="11"
                                                                     ToolTip="{Binding ProjectPath}"/>
                                                            <Button Grid.Column="1" 
                                                                    Content="📂" 
                                                                    Command="{Binding BrowseProjectPathCommand}" 
                                                                    Style="{StaticResource AccentButtonStyle}" 
                                                                    Margin="4,0,0,0" 
                                                                    Padding="6,2" 
                                                                    ToolTip="Выбрать папку целевого проекта"/>
                                                        </Grid>

                                                        <!-- Платформа: ComboBox -->
                                                        <ComboBox Grid.Column="2" 
                                                                  ItemsSource="{Binding PlatformList}" 
                                                                  SelectedItem="{Binding Platform, Mode=TwoWay}" 
                                                                  Style="{StaticResource DarkComboBoxStyle}" 
                                                                  FontSize="11"
                                                                  ToolTip="Платформа целевого проекта"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- Кнопки Сохранить и Отмена -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="↩ Отмена" Command="{Binding CancelProfileCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Padding="14,3"/>
                                <Button Content="💾 Сохранить" Command="{Binding SaveProfileCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,3"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!--  РАЗДЕЛИТЕЛЬ ДЛЯ РЕГУЛИРОВКИ ВЫСОТЫ МЫШКОЙ (GRID SPLITTER)                -->
                <!-- ========================================================================= -->
                <GridSplitter Grid.Row="2" 
                              Height="7" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Center" 
                              Background="Transparent" 
                              ResizeDirection="Rows" 
                              ResizeBehavior="PreviousAndNext" 
                              Cursor="SizeNS"
                              DragCompleted="GridSplitter_DragCompleted">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" Padding="0,2">
                                <Border x:Name="GripLine" Height="2" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GripLine" Property="Background" Value="{StaticResource TextPrimary}" />
                                    <Setter TargetName="GripLine" Property="Height" Value="3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- ========================================================================= -->
                <!--  БЛОК 3: ЛОГИ СБОРКИ                                                      -->
                <!-- ========================================================================= -->
                <Border Grid.Row="3" Style="{StaticResource BlockCardStyle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Шапка Блока 3 с кнопками скопировать/очистить логи -->
                        <Border Grid.Row="0" Style="{StaticResource BlockHeaderStyle}">
                            <Grid>
                                <TextBlock Text="ЛОГИ СБОРКИ" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📋 Скопировать логи" Command="{Binding CopyLogsCommand}" Style="{StaticResource AccentButtonStyle}" Padding="8,2" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="🗑 Очистить логи" Command="{Binding ClearLogsCommand}" Style="{StaticResource AccentButtonStyle}" Padding="8,2" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Содержимое Блока 3 -->
                        <Grid Grid.Row="1" Margin="10,6">
                            <Border BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="1" CornerRadius="3" Background="#060B13">
                                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6">
                                    <ItemsControl ItemsSource="{Binding LogItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FullText}" Foreground="{Binding Color}" FontWeight="{Binding FontWeight}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!--  ГЛАВНЫЕ ДЕЙСТВИЯ (В САМОМ НИЗУ ПОД БЛОКОМ ЛОГОВ)                         -->
                <!-- ========================================================================= -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                    <Button Content="▶ Старт сборки"
                            Command="{Binding StartOrCancelBuildCommand}" 
                            Style="{StaticResource AccentButtonStyle}" 
                            FontSize="13" 
                            Padding="18,5"/>
                </StackPanel>
            </Grid>

            <!-- 3. Панель состояния (Status Bar) -->
            <Border Grid.Row="2" Background="{StaticResource PanelHeaderBackground}" BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="0,1.5,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Статус слева -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Версия справа -->
                    <TextBlock Grid.Column="1" Text="v1.0.0" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
