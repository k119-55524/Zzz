<Window x:Class="assets_builder_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" 
        Height="{Binding WindowHeight, Mode=TwoWay}" 
        Width="{Binding WindowWidth, Mode=TwoWay}"
        Left="{Binding WindowLeft, Mode=TwoWay}"
        Top="{Binding WindowTop, Mode=TwoWay}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="False"
        Icon="pack://application:,,,/Properties/AppIcon.ico"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextLight}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="MaximizeWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="RestoreWindow_Executed" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="CloseWindow_Executed" />
    </Window.CommandBindings>

    <!-- Внешняя желтая рамка в стиле редактора -->
    <Border BorderBrush="{StaticResource TextPrimary}" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" /> <!-- Кастомная шапка -->
                <RowDefinition Height="*" />  <!-- Основное содержимое -->
                <RowDefinition Height="26" /> <!-- Панель состояния внизу -->
            </Grid.RowDefinitions>

            <!-- 1. Кастомная шапка (TitleBar) -->
            <Border Grid.Row="0" Background="{StaticResource PanelHeaderBackground}" BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="0,0,0,1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Иконка и заголовок -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Image Source="pack://application:,,,/Properties/AppIcon.ico" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WindowTitle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Кнопки управления окном (Свернуть, Развернуть, Закрыть) -->
                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButtonStyle}" 
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}" 
                                ToolTip="Свернуть">
                            <TextBlock Text="─" FontSize="10" Foreground="{StaticResource TextLight}"/>
                        </Button>
                        
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource ChromeButtonStyle}" 
                                Command="{x:Static SystemCommands.MaximizeWindowCommand}" 
                                ToolTip="Развернуть">
                            <TextBlock Text="🗖" FontSize="11" Foreground="{StaticResource TextLight}"/>
                        </Button>

                        <Button x:Name="RestoreButton"
                                Style="{StaticResource ChromeButtonStyle}" 
                                Command="{x:Static SystemCommands.RestoreWindowCommand}" 
                                ToolTip="Восстановить"
                                Visibility="Collapsed">
                            <TextBlock Text="🗗" FontSize="11" Foreground="{StaticResource TextLight}"/>
                        </Button>

                        <Button Style="{StaticResource ChromeCloseButtonStyle}" 
                                Command="{x:Static SystemCommands.CloseWindowCommand}" 
                                ToolTip="Закрыть">
                            <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextLight}" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Центральное окно UI -->
            <Grid Grid.Row="1" Background="{StaticResource PanelBackground}" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140" /> <!-- БЛОК 1: Список проектов + действия -->
                    <RowDefinition Height="Auto" /> <!-- БЛОК 2: Параметры проекта, пресеты и таргеты -->
                    <RowDefinition Height="*" />    <!-- БЛОК 3: Панель Логов -->
                    <RowDefinition Height="Auto" /> <!-- Кнопки действий в самом низу -->
                </Grid.RowDefinitions>

                <!-- ========================================================================= -->
                <!--  БЛОК 1: СПИСОК ПРОЕКТОВ И УПРАВЛЕНИЕ                                     -->
                <!-- ========================================================================= -->
                <Border Grid.Row="0" Style="{StaticResource BlockCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Шапка Блока 1 -->
                        <Border Grid.Row="0" Style="{StaticResource BlockHeaderStyle}">
                            <TextBlock Text="СПИСОК ПРОЕКТОВ АССЕТОВ" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11"/>
                        </Border>

                        <!-- Содержимое Блока 1 -->
                        <Grid Grid.Row="1" Margin="10,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0" 
                                     ItemsSource="{Binding ProfilesView}" 
                                     SelectedItem="{Binding SelectedProfile}"
                                     Background="#060B13" 
                                     BorderBrush="{StaticResource BlockBorderBrush}" 
                                     BorderThickness="1" 
                                     Margin="0,0,0,6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextLight}" Padding="6,2" FontSize="12"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Content="📂 Открыть проект..." Command="{Binding AddProfileCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Padding="10,3"/>
                                <Button Content="✨ + Создать проект..." Command="{Binding CreateNewProjectScaffoldCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Padding="10,3"/>
                                <Button Content="🗑 Удалить из списка" Command="{Binding DeleteProfileCommand}" Style="{StaticResource AccentButtonStyle}" Padding="10,3"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!--  БЛОК 2: ПАРАМЕТРЫ ПРОЕКТА, НАБОРЫ СБОРКИ (PRESETS) И ТАРГЕТЫ             -->
                <!-- ========================================================================= -->
                <Border Grid.Row="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource BlockCardStyle}">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSelectedProfile}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Шапка Блока 2 -->
                        <Border Grid.Row="0" Style="{StaticResource BlockHeaderStyle}">
                            <TextBlock Text="ПАРАМЕТРЫ ПРОЕКТА И СБОРКИ" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11"/>
                        </Border>

                        <!-- Содержимое Блока 2 -->
                        <Grid Grid.Row="1" Margin="10,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Ошибки строгой валидации структуры проекта -->
                            <Border Grid.Row="0" 
                                    Background="#3A1515" 
                                    BorderBrush="#FF5252" 
                                    BorderThickness="1" 
                                    CornerRadius="3" 
                                    Padding="8,4" 
                                    Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProfile.IsProjectValid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="⚠ ОШИБКА ВАЛИДАЦИИ СТРУКТУРЫ ПРОЕКТА (Сборка заблокирована):" Foreground="#FF5252" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedProfile.ValidationErrorsSummary}" Foreground="#FFC107" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- а. Имя профиля -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Имя профиля:" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                <TextBox Grid.Column="1" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PathTextBoxStyle}" MaxLength="255"/>
                            </Grid>

                            <!-- б. Путь к проекту (Источник) -->
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Папка проекта:" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                <TextBox Grid.Column="1" Text="{Binding SelectedProfile.SourcePath, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource PathTextBoxStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProfile.IsSourcePathValid}" Value="False">
                                                    <Setter Property="Foreground" Value="#FF5252" />
                                                    <Setter Property="BorderBrush" Value="#FF5252" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Column="2" Content="📂 Обзор..." Command="{Binding BrowseSourcePathCommand}" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" Padding="12,3"/>
                            </Grid>

                            <!-- в. Путь назначения -->
                            <Grid Grid.Row="3" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Папка сборки:" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                                <TextBox Grid.Column="1" Text="{Binding SelectedProfile.DestinationPath, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource PathTextBoxStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProfile.IsDestinationPathValid}" Value="False">
                                                    <Setter Property="Foreground" Value="#FF5252" />
                                                    <Setter Property="BorderBrush" Value="#FF5252" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Column="2" Content="📂 Обзор..." Command="{Binding BrowseDestinationPathCommand}" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" Padding="12,3"/>
                            </Grid>

                            <!-- г. Набор сборки (Preset Selector) + Таблица целевых проектов (Targets) -->
                            <Grid Grid.Row="4" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Набор сборки:" Foreground="{StaticResource TextLight}" VerticalAlignment="Top" Margin="0,4,0,0" FontWeight="SemiBold" FontSize="12"/>
                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                    
                                    <!-- Селектор пресета -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding SelectedProfile.Presets}"
                                                  SelectedItem="{Binding SelectedProfile.SelectedPreset}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource DarkComboBoxStyle}"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding SelectedProfile.SelectedPreset.Description}" 
                                                   Foreground="{StaticResource TextSecondary}" 
                                                   VerticalAlignment="Center" 
                                                   Margin="10,0,0,0" 
                                                   FontSize="11"/>
                                    </Grid>

                                    <!-- Заголовок таблицы таргетов -->
                                    <Border Background="#161B22" BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="1,1,1,0" Padding="6,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Сборка" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="Целевой проект" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="Платформа" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="Конфигурация платформы" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>

                                    <!-- Список таргетов выбранного набора сборки -->
                                    <Border Background="#060B13" BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="1" Padding="4" MaxHeight="130">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedProfile.SelectedPreset.Targets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40" />
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- Чекбокс активности -->
                                                            <CheckBox Grid.Column="0" 
                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                                                      VerticalAlignment="Center" 
                                                                      HorizontalAlignment="Left"
                                                                      Margin="6,0,0,0"
                                                                      ToolTip="Собирать данный целевой проект"/>

                                                            <!-- Имя таргета -->
                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding Name}" 
                                                                       Foreground="{StaticResource TextLight}" 
                                                                       FontWeight="SemiBold" 
                                                                       VerticalAlignment="Center" 
                                                                       FontSize="12"/>

                                                            <!-- Платформа -->
                                                            <TextBlock Grid.Column="2" 
                                                                       Text="{Binding Platform}" 
                                                                       Foreground="{StaticResource TextPrimary}" 
                                                                       VerticalAlignment="Center" 
                                                                       FontSize="11"/>

                                                            <!-- Выпадающий список платформенных конфигураций -->
                                                            <ComboBox Grid.Column="3"
                                                                      ItemsSource="{Binding AvailableConfigOptions}"
                                                                      SelectedItem="{Binding SelectedConfigOption}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      Style="{StaticResource DarkComboBoxStyle}"
                                                                      ToolTip="Выберите платформенный JSON-файл или 'None' для пропуска"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- д. Кнопки Сохранить и Отмена -->
                            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="↩ Отмена" Command="{Binding CancelProfileCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Padding="14,3"/>
                                <Button Content="💾 Сохранить" Command="{Binding SaveProfileCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,3"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!--  БЛОК 3: ЛОГИ СБОРКИ                                                      -->
                <!-- ========================================================================= -->
                <Border Grid.Row="2" Style="{StaticResource BlockCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Шапка Блока 3 с кнопками скопировать/очистить логи -->
                        <Border Grid.Row="0" Style="{StaticResource BlockHeaderStyle}">
                            <Grid>
                                <TextBlock Text="ЛОГИ СБОРКИ" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📋 Скопировать логи" Command="{Binding CopyLogsCommand}" Style="{StaticResource AccentButtonStyle}" Padding="8,2" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="🗑 Очистить логи" Command="{Binding ClearLogsCommand}" Style="{StaticResource AccentButtonStyle}" Padding="8,2" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Содержимое Блока 3 -->
                        <Grid Grid.Row="1" Margin="10,6">
                            <Border BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="1" CornerRadius="3" Background="#060B13">
                                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6">
                                    <ItemsControl ItemsSource="{Binding LogItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FullText}" Foreground="{Binding Color}" FontWeight="{Binding FontWeight}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================================================================= -->
                <!--  ГЛАВНЫЕ ДЕЙСТВИЯ (В САМОМ НИЗУ ПОД БЛОКОМ ЛОГОВ)                         -->
                <!-- ========================================================================= -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                    <Button Content="▶ Старт сборки"
                            Command="{Binding StartOrCancelBuildCommand}" 
                            Style="{StaticResource AccentButtonStyle}" 
                            FontSize="13" 
                            Padding="18,5"/>
                </StackPanel>
            </Grid>

            <!-- 3. Панель состояния (Status Bar) -->
            <Border Grid.Row="2" Background="{StaticResource PanelHeaderBackground}" BorderBrush="{StaticResource BlockBorderBrush}" BorderThickness="0,1.5,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Статус слева -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Версия справа -->
                    <TextBlock Grid.Column="1" Text="v1.0.0" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
