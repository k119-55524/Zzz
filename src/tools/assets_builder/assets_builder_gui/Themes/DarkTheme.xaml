<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!--  1. ЦВЕТОВАЯ ПАЛИТРА И ДИЗАЙН-ТОКЕНЫ (В стиле Zzz Editor)                 -->
    <!-- ========================================================================= -->

    <!-- Основной фон самого окна приложения (глубокий тёмно-синий/почти чёрный) -->
    <SolidColorBrush x:Key="WindowBackground" Color="#060B13" />

    <!-- Фон внутренних панелей и блоков редактирования -->
    <SolidColorBrush x:Key="PanelBackground" Color="#0D1929" />

    <!-- Фон шапки окна (TitleBar) и панели состояния (StatusBar) -->
    <SolidColorBrush x:Key="PanelHeaderBackground" Color="#112035" />

    <!-- Цвет обводок и разделительных линий между панелями -->
    <SolidColorBrush x:Key="BorderBrush" Color="#182E4B" />

    <!-- Акцентный песочно-жёлтый цвет заголовков и желтой внешней обводки -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E2C08D" />

    <!-- Вторичный сине-серый цвет для подсказок, версий и статусов -->
    <SolidColorBrush x:Key="TextSecondary" Color="#627A9C" />

    <!-- Основной светлый цвет текста для списка и полей ввода -->
    <SolidColorBrush x:Key="TextLight" Color="#CDD9E5" />

    <!-- Синий акцентный цвет для главных активных кнопок ("Старт сборки") -->
    <SolidColorBrush x:Key="AccentBrush" Color="#388AF6" />


    <!-- ========================================================================= -->
    <!--  2. СТИЛИ ПОЛЕЙ ВВОДА ПУТЕЙ И ИМЕН                                        -->
    <!-- ========================================================================= -->

    <!-- Базовый стиль для TextBox (темный фон, светлый текст, тонкая обводка) -->
    <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#0A1321" />
        <Setter Property="Foreground" Value="{StaticResource TextLight}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>


    <!-- ========================================================================= -->
    <!--  3. СТИЛИ КНОПОК ШАПКИ ОКНА (WindowChrome Buttons)                        -->
    <!-- ========================================================================= -->

    <!-- Стандартная системная кнопка шапки (Свернуть / Развернуть) -->
    <Style x:Key="ChromeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Width" Value="45" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1B3252" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка закрытия окна (с подсветкой ярким красным цветом при наведении) -->
    <Style x:Key="ChromeCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================================================================= -->
    <!--  4. СТИЛИ О Б Ы Ч Н Ы Х  И  А К Ц Е Н Т Н Ы Х  К Н О П О К                 -->
    <!-- ========================================================================= -->

    <!-- Стандартная стилизованная кнопка (Обзор, Добавить, Удалить, Сохранить, Отмена) -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#112035" />
        <Setter Property="Foreground" Value="{StaticResource TextLight}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1B3252" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Акцентная синяя кнопка для главных действий ("▶ Старт сборки") -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#388AF6" />
    </Style>

</ResourceDictionary>
