<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Цветовые токены тёмной темы в стиле Editor -->
    <SolidColorBrush x:Key="WindowBackground" Color="#0D1117" />
    <SolidColorBrush x:Key="PanelBackground" Color="#161B22" />
    <SolidColorBrush x:Key="PanelHeaderBackground" Color="#21262D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#30363D" />

    <!-- Яркая выразительная рамка блоков GUI -->
    <SolidColorBrush x:Key="BlockBorderBrush" Color="#388BFD" />
    <SolidColorBrush x:Key="BlockHeaderBackground" Color="#16253B" />
    <SolidColorBrush x:Key="BlockContentBackground" Color="#0B1320" />

    <!-- Акцентный желтый цвет редактора Zzz -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E5C07B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8B949E" />
    <SolidColorBrush x:Key="TextLight" Color="#F0F6FC" />

    <!-- Стиль рамки блоков GUI (Выразительная граница) -->
    <Style x:Key="BlockCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BlockContentBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource BlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="BlockHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BlockHeaderBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource BlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Стиль стандартных текстовых полей ввода путей -->
    <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#0D1117" />
        <Setter Property="Foreground" Value="{StaticResource TextLight}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Стиль обычных кнопок -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#21262D" />
        <Setter Property="Foreground" Value="{StaticResource TextLight}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#30363D" />
                <Setter Property="BorderBrush" Value="{StaticResource TextPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль акцентных кнопок (Старт сборки / Сохранить) -->
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#1F6FEB" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#388BFD" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#388BFD" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Кнопки управления окном (Свернуть / Развернуть) -->
    <Style x:Key="ChromeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="30" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#30363D" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Кнопка закрытия окна (Красная при наведении) -->
    <Style x:Key="ChromeCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#DA3633" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
