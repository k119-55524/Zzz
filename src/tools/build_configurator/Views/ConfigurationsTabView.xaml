<UserControl x:Class="BuildConfigurator.Views.ConfigurationsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BuildConfigurator.ViewModels"
             xmlns:dialogs="clr-namespace:BuildConfigurator.Views.Dialogs">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: Config List ── -->
        <Border Grid.Column="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="12,10">
                    <TextBlock Text="Конфигурации" Style="{StaticResource HeadingStyle}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Добавить конфигурацию"
                                Click="AddConfig_Click">
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold" LineHeight="18"
                                       Foreground="{StaticResource BrushTextSecondary}"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Удалить конфигурацию"
                                Command="{Binding DeleteConfigurationCommand}"
                                Margin="2,0,0,0">
                            <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                                  Stroke="{StaticResource BrushDanger}"
                                  StrokeThickness="2" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,0"/>

                <!-- List -->
                <ListBox Grid.Row="1"
                         x:Name="ConfigListBox"
                         ItemsSource="{Binding ConfigItems}"
                         SelectedItem="{Binding SelectedConfigItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="8,4"
                         ItemContainerStyle="{StaticResource ConfigListItemStyle}"
                         MouseDoubleClick="ConfigListBox_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <TextBlock Grid.Row="2"
                           Text="{Binding TotalConfigsText}"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="12,8"/>
            </Grid>
        </Border>

        <!-- ── Splitter ── -->
        <GridSplitter Grid.Column="1" Width="4"
                      Background="{StaticResource BrushBorder}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- ── Right: Defines Panel ── -->
        <Border Grid.Column="2" Background="{StaticResource BrushBackground}">
            <Grid>
                <!-- No selection placeholder -->
                <TextBlock Text="Выберите конфигурацию"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedConfig}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Content -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedConfig}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Defines heading + search -->
                    <Grid Grid.Row="0" Margin="20,16,20,8">
                        <TextBlock Text="{Binding ActiveDefinesCountText}"
                                   Style="{StaticResource HeadingStyle}"
                                   VerticalAlignment="Center"/>
                        <Grid HorizontalAlignment="Right" Width="220">
                            <TextBox Text="{Binding DefinesSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Padding="8,5,32,5"
                                     FontSize="12"/>
                            <TextBlock Text="Поиск дефайна..."
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefinesSearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Path Data="M 8,4 C 10.2,4 12,5.8 12,8 C 12,10.2 10.2,12 8,12 C 5.8,12 4,10.2 4,8 C 4,5.8 5.8,4 8,4 Z M 11,11 L 15,15"
                                  Stroke="{StaticResource BrushTextMuted}"
                                  StrokeThickness="1.5" Width="16" Height="16"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                  IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <!-- Defines DataGrids -->
                    <Grid Grid.Row="1" Margin="20,0,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Project Defines -->
                        <Border Grid.Row="0" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource BrushSurfaceAlt}" Padding="10,6">
                                    <TextBlock Text="Дефайны проекта" Style="{StaticResource LabelStyle}"/>
                                </Border>
                                <DataGrid Grid.Row="1" x:Name="ProjectDefinesGrid"
                                          ItemsSource="{Binding FilteredProjectEntries}"
                                          Style="{StaticResource DarkDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                          CellStyle="{StaticResource DarkDataGridCellStyle}"
                                          IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="40" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              Style="{StaticResource DarkCheckBoxStyle}"
                                                              HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Дефайн" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- CMake Defines -->
                        <Border Grid.Row="1" Margin="0,10,0,20"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource BrushSurfaceAlt}" Padding="10,6">
                                    <TextBlock Text="CMake Дефайны" Style="{StaticResource LabelStyle}"/>
                                </Border>
                                <DataGrid Grid.Row="1" x:Name="CMakeDefinesGrid"
                                          ItemsSource="{Binding FilteredCMakeEntries}"
                                          Style="{StaticResource DarkDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                          CellStyle="{StaticResource DarkDataGridCellStyle}"
                                          IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="40" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                              Style="{StaticResource DarkCheckBoxStyle}"
                                                              HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Дефайн" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
