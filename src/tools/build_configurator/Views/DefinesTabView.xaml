<UserControl x:Class="BuildConfigurator.Views.DefinesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BuildConfigurator.ViewModels">

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Панель инструментов ── -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Padding="6"
                            ToolTip="Добавить дефайн"
                            Click="AddDefine_Click">
                        <Path Data="M 3 8 L 13 8 M 8 3 L 8 13"
                              Stroke="{StaticResource BrushTextPrimary}"
                              StrokeThickness="2" Width="16" Height="16" Stretch="None"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Padding="6"
                            ToolTip="Удалить дефайн"
                            Command="{Binding DeleteDefineCommand}"
                            Margin="4,0,0,0">
                        <Path Data="M 3 3 L 13 13 M 13 3 L 3 13"
                              Stroke="{StaticResource BrushDanger}"
                              StrokeThickness="2" Width="16" Height="16" Stretch="None"/>
                    </Button>
                </StackPanel>

                <!-- Поиск -->
                <Grid HorizontalAlignment="Right" Width="240">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Padding="8,5,32,5" FontSize="12"/>
                    <TextBlock Text="Поиск дефайна..."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Path Data="M 8,4 C 10.2,4 12,5.8 12,8 C 12,10.2 10.2,12 8,12 C 5.8,12 4,10.2 4,8 C 4,5.8 5.8,4 8,4 Z M 11,11 L 15,15"
                          Stroke="{StaticResource BrushTextMuted}"
                          StrokeThickness="1.5" Width="16" Height="16"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,8,0" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Таблица ── -->
        <Border Grid.Row="1" Margin="16" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <DataGrid x:Name="DefinesGrid"
                      ItemsSource="{Binding FilteredDefines}"
                      SelectedItem="{Binding SelectedDefine}"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                      IsReadOnly="False"
                      MouseDoubleClick="DefinesGrid_DoubleClick">

                <DataGrid.Columns>
                    <!-- Кнопка состояния — первая колонка -->
                    <DataGridTemplateColumn Header="Состояние" Width="110" CanUserResize="False" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="ArchiveButton_Click"
                                        Margin="4,2" Padding="8,4"
                                        BorderThickness="0"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="Спрятать"/>
                                            <Setter Property="Background" Value="#4CAF50"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                    <Setter Property="Content" Value="Использовать"/>
                                                    <Setter Property="Background" Value="#FF4C4C"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дефайн"   Binding="{Binding DisplayName}" Width="*"  IsReadOnly="True"/>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ── Строка состояния ── -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}"/>
        </Border>
    </Grid>
</UserControl>
